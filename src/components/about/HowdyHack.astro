---
import { Picture } from "astro:assets";
import A2 from "@assets/about/gen-info-a.png";
import C2 from "@assets/about/gen-info-c.png";
import D1 from "@assets/about/gen-info-d.png";
import H2 from "@assets/about/gen-info-h.png";
import H1 from "@assets/about/gen-info-h-1.png";
import K2 from "@assets/about/gen-info-k.png";
import O1 from "@assets/about/gen-info-o.png";
import W1 from "@assets/about/gen-info-w.png";
import Y1 from "@assets/about/gen-info-y.png";
import WelcBot from "@assets/about/welcome-bottle.png";
---

<div id="howdyhack-bubbles" class="relative w-full">
    <div id="bottle" class="absolute z-20" style="">
        <Picture
            id="WelcBot"
            src={WelcBot}
            formats={["avif","webp"]}
            alt=""
            class="w-full h-auto bob-anim"
        />
    </div>
    <Picture
        id="H1"
        src={H1}
        formats={["avif","webp"]}
        alt=""
        class="h-auto bob-anim"
        style=""
    />
    <Picture
        id="O1"
        src={O1}
        formats={["avif","webp"]}
        alt=""
        class="h-auto bob-anim"
        style=""
    />
    <Picture
        id="W1"
        src={W1}
        formats={["avif","webp"]}
        alt=""
        class="h-auto bob-anim"
        style=""
    />
    <Picture
        id="D1"
        src={D1}
        formats={["avif","webp"]}
        alt=""
        class="h-auto bob-anim"
        style=""
    />
    <Picture
        id="Y1"
        src={Y1}
        formats={["avif","webp"]}
        alt=""
        class="h-auto bob-anim"
        style=""
    />
    <Picture
        id="H2"
        src={H2}
        formats={["avif","webp"]}
        alt=""
        class="h-auto bob-anim z-20"
        style=""
    />
    <Picture
        id="A2"
        src={A2}
        formats={["avif","webp"]}
        alt=""
        class="h-auto bob-anim z-20"
        style=""
    />
    <Picture
        id="C2"
        src={C2}
        formats={["avif","webp"]}
        alt=""
        class="h-auto bob-anim z-20"
        style=""
    />
    <Picture
        id="K2"
        src={K2}
        formats={["avif","webp"]}
        alt=""
        class="h-auto bob-anim z-20"
        style=""
    />
</div>

<style>
#howdyhack-bubbles {
    width: 42rem;
    aspect-ratio: 5 / 2;
    min-height: unset;
    margin: 1rem auto;
}

@media (prefers-reduced-motion: no-preference) {
    .bob-anim {
        animation: bob 2s ease-in-out infinite;
    }
}
#WelcBot {
    animation-delay: 0.5s;
}
#bottle {
    width: 60%;
    top: -60%;
    left: -10%;
}
#H1 {
    animation-delay: 0s;
    position: absolute;
    width: 21%;
    left: 8%;
    top: 3%;
}
#O1 {
    animation-delay: 0.15s;
    position: absolute;
    width: 14%;
    left: 28%;
    top: 10%;
}
#W1 {
    animation-delay: 0.3s;
    position: absolute;
    width: 17%;
    left: 41%;
    top: 5%;
}
#D1 {
    animation-delay: 0.45s;
    position: absolute;
    width: 14%;
    left: 57%;
    top: 10%;
}
#Y1 {
    animation-delay: 0.6s;
    position: absolute;
    width: 17%;
    left: 70%;
    top: 4%;
}
#H2 {
    animation-delay: 0.75s;
    position: absolute;
    width: 18%;
    left: 26%;
    top: 49%;
}
#A2 {
    animation-delay: 0.9s;
    position: absolute;
    width: 16%;
    left: 43%;
    top: 55%;
}
#C2 {
    animation-delay: 1.05s;
    position: absolute;
    width: 16%;
    left: 58%;
    top: 53%;
}
#K2 {
    animation-delay: 1.2s;
    position: absolute;
    width: 18%;
    left: 74%;
    top: 56%;
}
@keyframes bob {
    0%,
    100% {
        transform: translateY(0);
    }
    50% {
        transform: translateY(-10px);
    }
}
@media (width < 64rem) {
    #howdyhack-bubbles {
        width: 100%;
        max-width: 20rem;
        transform: translateY(7rem);
        z-index: 10;
    }
    @keyframes bob {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-7px);
        }
    }
    #WelcBot {
        animation-delay: 0.5s;
    }
    #bottle {
        width: 85%;
        top: -115%;
        left: 1%;
    }
}
</style>

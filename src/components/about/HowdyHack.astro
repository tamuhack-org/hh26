---
import { Picture } from "astro:assets";
import A2 from "@assets/about/gen-info-a.png";
import C2 from "@assets/about/gen-info-c.png";
import D1 from "@assets/about/gen-info-d.png";
import H2 from "@assets/about/gen-info-h.png";
import H1 from "@assets/about/gen-info-h-1.png";
import K2 from "@assets/about/gen-info-k.png";
import O1 from "@assets/about/gen-info-o.png";
import W1 from "@assets/about/gen-info-w.png";
import Y1 from "@assets/about/gen-info-y.png";
import WelcBot from "@assets/about/welcome-bottle.png";
---

<div id="howdyhack-bubbles" class="relative w-full">
  <div id="bottle" class="absolute z-20" style="">
    <Picture
      id="WelcBot"
      src={WelcBot}
      formats={["avif","webp"]}
      alt=""
      class="w-full h-auto bob-anim"
    />
  </div>
  <Picture
    id="H1"
    src={H1}
    formats={["avif","webp"]}
    alt=""
    class="h-auto bob-anim"
    style=""
  />
  <Picture
    id="O1"
    src={O1}
    formats={["avif","webp"]}
    alt=""
    class="h-auto bob-anim"
    style=""
  />
  <Picture
    id="W1"
    src={W1}
    formats={["avif","webp"]}
    alt=""
    class="h-auto bob-anim"
    style=""
  />
  <Picture
    id="D1"
    src={D1}
    formats={["avif","webp"]}
    alt=""
    class="h-auto bob-anim"
    style=""
  />
  <Picture
    id="Y1"
    src={Y1}
    formats={["avif","webp"]}
    alt=""
    class="h-auto bob-anim"
    style=""
  />
  <Picture
    id="H2"
    src={H2}
    formats={["avif","webp"]}
    alt=""
    class="h-auto bob-anim z-20"
    style=""
  />
  <Picture
    id="A2"
    src={A2}
    formats={["avif","webp"]}
    alt=""
    class="h-auto bob-anim z-20"
    style=""
  />
  <Picture
    id="C2"
    src={C2}
    formats={["avif","webp"]}
    alt=""
    class="h-auto bob-anim z-20"
    style=""
  />
  <Picture
    id="K2"
    src={K2}
    formats={["avif","webp"]}
    alt=""
    class="h-auto bob-anim z-20"
    style=""
  />
</div>

<style>
#howdyhack-bubbles {
  width: 100%;
  aspect-ratio: 5 / 3;
  min-height: unset;

  @media (width >= 64rem) {
    font-size: 6rem;
    max-width: 96rem;
    margin: 0 auto;
  }
}

.bob-anim {
  animation: bob 2s ease-in-out infinite;
}
#WelcBot {
  animation-delay: 0.5s;
}
#bottle {
  width: 30%;
  top: 10%;
  left: 10%;
}
#H1 {
  animation-delay: 0s;
  position: absolute;
  width: 15%;
  left: 15%;
  top: 35%;
}
#O1 {
  animation-delay: 0.15s;
  position: absolute;
  width: 10%;
  left: 31%;
  top: 40%;
}
#W1 {
  animation-delay: 0.3s;
  position: absolute;
  width: 13%;
  left: 41%;
  top: 35%;
}
#D1 {
  animation-delay: 0.45s;
  position: absolute;
  width: 10%;
  left: 55%;
  top: 35%;
}
#Y1 {
  animation-delay: 0.6s;
  position: absolute;
  width: 13%;
  left: 65%;
  top: 30%;
}
#H2 {
  animation-delay: 0.75s;
  position: absolute;
  width: 13%;
  left: 30%;
  top: 65%;
}
#A2 {
  animation-delay: 0.9s;
  position: absolute;
  width: 12%;
  left: 43%;
  top: 68%;
}
#C2 {
  animation-delay: 1.05s;
  position: absolute;
  width: 13%;
  left: 55%;
  top: 63%;
}
#K2 {
  animation-delay: 1.2s;
  position: absolute;
  width: 13%;
  left: 68%;
  top: 70%;
}
@keyframes bob {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-15px);
  }
}
@media (max-width: 768px) {
  #howdyhack-bubbles {
    aspect-ratio: 1 / 1;
  }
  #bottle {
    width: 65%;
    top: 5%;
    left: 5%;
  }
  #H1 {
    width: 20%;
    left: 8%;
  }
  #O1 {
    width: 13%;
    left: 30%;
  }
  #W1 {
    width: 15%;
    left: 42%;
  }
  #D1 {
    width: 15%;
    left: 56%;
  }
  #Y1 {
    width: 15%;
    top: 32%;
    left: 70%;
  }
  #H2 {
    width: 20%;
    left: 25%;
    top: 55%;
  }
  #A2 {
    width: 15%;
    left: 44%;
    top: 60%;
  }
  #C2 {
    width: 15%;
    left: 59%;
    top: 58%;
  }
  #K2 {
    width: 15%;
    left: 75%;
    top: 56%;
  }
}
</style>

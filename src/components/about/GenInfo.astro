    ---
    import { Picture } from "astro:assets";
    import Bubble from "@assets/about/gen-info-bubble.png"
    import LocRay from "@assets/about/location-ray.png"
    import ParkRay from "@assets/about/parking-ray.png"
    import TeamBub from "@assets/about/gen-info-team.png"
    import AppBub from "@assets/about/gen-info-application.png"
    import HarRay from "@assets/about/hardware-ray.png"
    import HarBub from "@assets/about/gen-info-hardware.png"
    import N from "@assets/about/gen-info-new-n.png"
    import E from "@assets/about/gen-info-new-e.png"
    import W from "@assets/about/gen-info-new-w.png"
    import Exclamation from "@assets/about/gen-info-new-!.png"
    ---
    <div id="intro" aria-labelledby="About HowdyHack">
        <div id="Bubble">
            <Picture
            src={Bubble}
            alt="About HowdyHack"
            formats={["avif","webp"]}
            class="w-full h-auto"
            />
            <p id="bubble-text">
                HowdyHack is a 24-hour, themed, <strong>beginner-focused</strong> hackathon exclusively for <strong>Texas A&M students</strong>,
                 designed to showcase TAMU's diverse range of ideas in a collaborative environment. At the event, 
                you'll have the opportunity to create your own software and hardware products with <strong>teams of up to 4</strong> that wow judges and win prizes.
                <span class="gig-em"><strong>Go gig 'em!</strong></span>
            </p>
        </div>
    </div>

    <section id="Location" aria-labelledby="Location">
        <h3 id="Location-Title" class="sr-only">Location</h3>
        <div id="stingray">
            <a href="/building-map" id="location-ray">
            <Picture
                src={LocRay}
                alt="View building map"
                formats={["avif","webp"]}
                class="w-full h-auto"
            />
            </a>
            <div id="location-text">
                <p>
                    MSC 2400 730 Olsen Blvd, 
                    <br>College Station, TX 77845
                </p>
            </div>
        </div>
    </section>

    <section id="Parking" aria-label="Parking">
        <h3 id="Parking-Title" class="sr-only">Parking</h3>
        <div id="parking-ray">
            <Picture
                src={ParkRay}
                alt="Parking"
                class="w-full h-auto"
            />
        </div>
        <div id="parking-ray-text">
            <p>
                Parking will be available at _____ and _____
            </p>
        </div>
        <div id="team-info">
            <Picture
                src={TeamBub}
                alt="Team Information"
                class="w-full h-auto"
            />
            <p id="team-info-text">
            After you sign up, you will receive a confirmation email letting you know you're good to go. 
            You can either <strong>form a team</strong> yourself, or <strong>find one during the team building portion</strong> right before the competition! 
            This phase is designed for forming well-rounded teams that bring together diverse strengths and perspectives.
            </p>
        </div>
    </section>

    <section id="Application" aria-label="Application Information">
        <h3 id="Application-Title" class="sr-only">Application Information</h3>
        <Picture
            src={AppBub}
            alt="Application Information"
            class="w-full h-auto"
        />
        <p id="application-text">
            Applications are considered on a rolling basis; 
            an application being accepted does not guarantee a spot in the hackathon. 
            We have a limited space at the MSC, so we kindly ask you to <strong>arrive early</strong> on the day of the hackathon.
        </p>
    </section>

    <section id="Hardware" aria-label="Hardware Information">
        <h3 id="Hardware-Title" class="sr-only">Hardware Information</h3>
        <div id="hardware-ray">
            <Picture 
                src={HarRay}
                alt="Hardware Information"
                class="w-full h-auto"
            />
        </div>
        <Picture
            src={HarBub}
            alt=""
            id="hardware-bub"
            densities={[1,2]}
            quality={80}
            loading={"lazy"}
            fetchpriority={"high"}
            class="w-full h-auto"
        />
        <div id="new-bubbles">
            <Picture
                src={N}
                alt=""
                id="bubble-n"
                densities={[1,2]}
                quality={80}
                loading={"lazy"}
                fetchpriority={"high"}
                class="w-full h-auto new-bubble"
            />
            <Picture
                src={E}
                alt=""
                id="bubble-e"
                densities={[1,2]}
                quality={80}
                loading={"lazy"}
                fetchpriority={"high"}
                class="w-full h-auto new-bubble"
            />
            <Picture
                src={W}
                alt=""
                id="bubble-w"
                densities={[1,2]}
                quality={80}
                loading={"lazy"}
                fetchpriority={"high"}
                class="w-full h-auto new-bubble"
            />
            <Picture
                src={Exclamation}
                alt=""
                id="bubble-excl"                
                densities={[1,2]}
                quality={80}
                loading={"lazy"}
                fetchpriority={"high"}
                class="w-full h-auto new-bubble"
            />
        </div>
        <div id="hardware-text">
            <p>
                For the first time, HowdyHack will be supporting a hardware track! 
                The <strong>hardware track</b> will begin a week earlier on </strong>October 16th</b>, 
                and teams will have a week to create their projects!
            </p>
        </div>
    </section>

<style>
    #Bubble{
        position:relative;
        top: -27vw;
    }
    #bubble-text {
        position: absolute;
        inset: 0;
        font-size: 2vw;
        line-height: 1.5;
        transform: translateY(45%);
        padding: 5vw;
        text-align: center;
        overflow: hidden;
    }
    .gig-em{
        display: block;
        margin-top:1.2em;
    }
    #Location{
        position:relative;
        min-height: 10vw;
    }
    #stingray{
        position: absolute;
        width: 70%;
        right: -16%;
        bottom: 25%;
    }
    #location-text{
        position:absolute;
        top: 45%;
        left: 35%;
        width: 45%;
        font-size:1.4vw;
        z-index:10;
    }
    #Parking{
        position: relative;
        min-height: 40vw;
    }
    #parking-ray{
        position: absolute;
        width: 50%;
        left: -8%;
        bottom: 10%;
    }
    #parking-ray-text{
        color: white;
        position:absolute;
        top: 45%;
        left: 15%;
        right: 65%;
        font-size:1.5vw;
        text-align: center;
        z-index:10;
    }
    #team-info{
        position: absolute;
        width: 50%;
        right: 2%;
        bottom: 15%;
    }
    #team-info-text{
        position:absolute;
        top: 7%;
        left: 20%;
        right: 20%;
        font-size:1.8vw;
        text-align: center;
        z-index:10;
    }
    #Application{
        position: relative;
        min-height: 40vw;
        max-width: 80%;
        margin: 0% auto;
        transform: translateX(-5%); 
    }
    #application-text{
        position:absolute;
        top: 15%;
        left: 10%;
        right: 15%;
        font-size:1.8vw;
        text-align: center;
        z-index:10;
    }
    #application-text p{
        font-size: 2vw;
        line-height:1.5;
        text-align:center;
    }
    #Hardware{
        position: relative;
        min-height: 40vw;
    }
    #hardware-ray{
        position: absolute;
        width: 80%;
        right: -23%;
        top: -85%;
        z-index: 20;
    }
    #hardware-bub{
        position: absolute;
        max-width: 70%;
        margin-left: 3%;
    }
    #hardware-text{
        position:absolute;
        top: 15%;
        left: 15%;
        right: 45%;
        font-size:1.7vw;
        text-align: center;
    }
    #new-bubbles{
        position: relative;
    }
    .new-bubble{
        position: absolute;
        height: auto;
        animation: bob 2s ease-in-out infinite;
    }
    #bubble-n{
        width: 10%;
        top: -3vw;
        left: 2%;
        animation-delay: 0.75s
    }
    #bubble-e{
        width: 10%;
        top: -5vw;
        left: 10%;
        animation-delay: 0.90s
    }
    #bubble-w{
        width: 10%;
        top: -6vw;
        left: 18%;
        animation-delay: 1.05s;
    }
    #bubble-excl{
        width: 8%;
        top: -7vw;
        left: 26%;
        animation-delay: 1.20s;
    }
</style>
---
import { getImage } from "astro:assets";
import FishTrail from "@assets/about/fish-trail.png";
import BackgroundLines from "./BackgroundLines.astro";
import FishGenInfo from "./FishGenInfo.astro";
import GenInfoComponent from "./GenInfo.astro";
import HowdyHackComponent from "./HowdyHack.astro";

const OptimizedFishTrail = await getImage({
    src: FishTrail,
    format: "avif",
    quality: 80,
});
---

<section
    id="about"
    class="w-full overflow-x-clip overflow-y-visible gap-6 p-4 pb-56 mt-[-1rem] geninfo"
    style={`--fish-trail-image: url('${OptimizedFishTrail.src}');`}
    aria-labelledby="about-title"
>
    <h2 id="about-title" class="sr-only">About</h2>
    <div class="geninfo-content">
        <BackgroundLines />
        <FishGenInfo />
        <HowdyHackComponent />
        <GenInfoComponent />
    </div>
</section>

<style>
.geninfo {
    /* Keep the scene at 1668 × 2415 CSS pixels regardless of export resolution. */
    --fish-trail-width: 104.25rem;
    --fish-trail-height: 150.9375rem;
    background-image: linear-gradient(#6bb3b6 25%, #55aabc 50%, #4e55a7 100%);
}

.geninfo-content {
    position: relative;
    z-index: 1;
}

.geninfo-content::before {
    position: absolute;
    top: auto;
    left: 50%;
    transform: translateX(-50%);
    width: var(--fish-trail-width);
    height: var(--fish-trail-height);
    z-index: -1;
    content: "";
    pointer-events: none;
    background-image: var(--fish-trail-image);
    background-size: var(--fish-trail-width) var(--fish-trail-height);
    background-repeat: no-repeat;
    background-position: center;
}

@media (min-width: 64rem) {
    .geninfo-content {
        margin-top: -8rem;
    }
}
</style>

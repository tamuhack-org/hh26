---
import { Picture } from "astro:assets";
import H1 from "@assets/about/gen-info-h-1.png" 
import O1 from "@assets/about/gen-info-o.png"
import W1 from "@assets/about/gen-info-w.png"
import D1 from "@assets/about/gen-info-d.png"
import Y1 from "@assets/about/gen-info-y.png"
import H2 from "@assets/about/gen-info-h.png"
import A2 from "@assets/about/gen-info-a.png"
import C2 from "@assets/about/gen-info-c.png"
import K2 from "@assets/about/gen-info-k.png"
import WelcBot from "@assets/about/welcome-bottle.png"
---

<section
  id="about"
  class="w-full aspect-square bg-[#6CB3B7] mt-[-1rem]"
  aria-labelledby="about-title"
>
  <h2 id="about-title" class="sr-only">About</h2>

  <div id="bottle" class="absolute top-345 left-50 z-20">
    <Picture
      id="WelcBot"
      src={WelcBot}
      formats={["avif", "webp"]}
      alt=""
      aria-hidden="true"
      loading="eager"
      fetchpriority="high"
      class="w-[400px] h-auto bob-anim"
    />
  </div>
  
  <div id="howdy-row" class="pt-[2rem] flex items-center justify-center">
    <Picture
      id="H1"
      src={H1}
      formats={["avif", "webp"]}
      alt=""
      aria-hidden="true"
      loading="eager"
      fetchpriority="high"
      class="w-[150px] h-auto bob-anim"
    />
    <Picture
      id="O1"
      src={O1}
      formats={["avif", "webp"]}
      alt=""
      aria-hidden="true"
      loading="eager"
      fetchpriority="high"
      class="w-[150px] h-auto bob-anim"
    />
    <Picture
      id="W1"
      src={W1}
      formats={["avif", "webp"]}
      alt=""
      aria-hidden="true"
      loading="eager"
      fetchpriority="high"
      class="w-[150px] h-auto bob-anim"
    />
    <Picture
      id="D1"
      src={D1}
      formats={["avif", "webp"]}
      alt=""
      aria-hidden="true"
      loading="eager"
      fetchpriority="high"
      class="w-[150px] h-auto bob-anim"
    />
    <Picture
      id="Y1"
      src={Y1}
      formats={["avif", "webp"]}
      alt=""
      aria-hidden="true"
      loading="eager"
      fetchpriority="high"
      class="w-[150px] h-auto bob-anim"
    />
  </div>

  <div id="hack-row" class="mt-[1rem] flex items-center justify-center">
    <Picture
      id="H2"
      src={H2}
      formats={["avif", "webp"]}
      alt=""
      aria-hidden="true"
      loading="eager"
      fetchpriority="high"
      class="w-[150px] h-auto bob-anim"
    />
    <Picture
      id="A2"
      src={A2}
      formats={["avif", "webp"]}
      alt=""
      aria-hidden="true"
      loading="eager"
      fetchpriority="high"
      class="w-[150px] h-auto bob-anim"
    />
    <Picture
      id="C2"
      src={C2}
      formats={["avif", "webp"]}
      alt=""
      aria-hidden="true"
      loading="eager"
      fetchpriority="high"
      class="w-[150px] h-auto bob-anim"
    />
    <Picture
      id="K2"
      src={K2}
      formats={["avif", "webp"]}
      alt=""
      aria-hidden="true"
      loading="eager"
      fetchpriority="high"
      class="w-[150px] h-auto bob-anim"
    />
  </div>
  
</section>

<style>
  .bob-anim {
    animation: bob 2s ease-in-out infinite;
  }
  #WelcBot { animation-delay: 0.5s; }

  #H1 { animation-delay: 0s; }
  #O1 { animation-delay: 0.15s; }
  #W1 { animation-delay: 0.30s; }
  #D1 { animation-delay: 0.45s; }
  #Y1 { animation-delay: 0.60s; }

  #H2 { animation-delay: 0.75s; }
  #A2 { animation-delay: 0.90s; }
  #C2 { animation-delay: 1.05s; }
  #K2 { animation-delay: 1.20s; }

  @keyframes bob {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-15px); 
    }
  }
</style>
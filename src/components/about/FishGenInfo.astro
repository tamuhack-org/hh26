---
import { Picture } from "astro:assets";
import BabyFish from "@assets/about/baby-fish.png";

const babyFishPath =
  "M453.715 7.40625C165.215 53.4062 53.2148 321.406 239.715 407.906C491.715 558.906 1042.21 459.406 1233.71 659.406C1475.26 911.672 1084.21 1074.63 900.715 1095.91C659.216 1123.91 251.214 1219.91 55.7139 1482.41C-139.786 1744.91 297.714 2036.91 678.214 2011.41C1292.21 1970.26 1792.71 2552.41 390.215 2813.91";
---

<div class="baby-fish-scene">
  <svg
    class="absolute top-0 left-0 w-full h-full"
    viewBox="0 0 1401 2793.44"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path id="babyfish-motion-path" d={babyFishPath} fill="none" />
  </svg>
  <Picture
    id="babyfish"
    src={BabyFish}
    formats={["avif", "webp"]}
    quality={80}
    alt=""
    aria-hidden="true"
    loading="eager"
    fetchpriority="high"
    width={200}
    sizes="1.5rem"
    class="absolute top-0 left-0 w-[1.5rem] h-auto max-w-none"
  />
</div>

<style>
#babyfish {
  transform: scaleY(-1);
}

.baby-fish-scene {
  position: absolute;
  top: 1rem;
  bottom: 1rem;
  left: 50%;
  transform: translateX(-55%);
  width: 1400px;
  max-width: 140%;
  pointer-events: none;
  z-index: 2;
}
@media (min-width: 64rem) and (prefers-reduced-motion: no-preference) {
  #babyfish {
    opacity: 0;
  }
}
</style>

<script>
import { gsap } from "gsap";
import { MotionPathPlugin } from "gsap/MotionPathPlugin";
import { ScrollTrigger } from "gsap/ScrollTrigger";
import { MEDIA } from "../../media";

gsap.registerPlugin(MotionPathPlugin, ScrollTrigger);

const fishAngle = 105;
const fishEndScale = 10;

gsap.matchMedia().add(`${MEDIA.desktop} and ${MEDIA.motionSafe}`, () => {
  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: ".baby-fish-scene",
      start: "top center",
      end: "bottom center",
      scrub: 0.3,
      invalidateOnRefresh: true,
    },
  });

  tl.fromTo(
    "#babyfish",
    { scaleX: 0.5, scaleY: -0.5 },
    {
      scaleX: fishEndScale,
      scaleY: -fishEndScale,
      duration: 1,
      ease: "none",
      transformOrigin: "50% 31%",
      motionPath: {
        path: "#babyfish-motion-path",
        align: "#babyfish-motion-path",
        start: 0,
        end: 1,
        autoRotate: fishAngle,
        alignOrigin: [0.5, 0.31],
      },
    },
    0,
  );

  tl.fromTo(
    "#babyfish",
    { autoAlpha: 0 },
    {
      autoAlpha: 1,
      duration: 0.1,
      ease: "power1.out",
    },
    0,
  );

  tl.to(
    "#babyfish",
    {
      autoAlpha: 0,
      duration: 0.15,
      ease: "power1.in",
    },
    0.8,
  );

  return () => {
    tl.kill();
    gsap.set("#babyfish", { clearProps: "all" });
  };
});
</script>

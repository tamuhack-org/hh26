---
import LinkSection from "./LinkSection.astro";

const resources = [
    // {
    //     name: 'Hacker Guide',
    //     link: 'https://tamuhack.org/guide',
    // },
    { name: "HelpR", link: "https://helpr.tamuhack.org/" },
    {
        name: "Code of Conduct",
        link: "https://static.mlh.io/docs/mlh-code-of-conduct.pdf",
    },
    { name: "Misconduct Reporting", link: "https://tamuhack.org/misconduct" },
    // { name: 'Team Formation', link: 'https://forms.gle/gnL8McG6ykkNRwhf9' },
    // { name: 'Devpost', link: 'https://tamuhack.org/devpost' },
];

const socials = [
    { name: "Instagram", link: "https://www.instagram.com/tamuhack" },
    { name: "TikTok", link: "https://www.tiktok.com/@tamuhack" },
    { name: "LinkedIn", link: "https://www.linkedin.com/company/tamuhack" },
    { name: "Discord", link: "https://tamuhack.org/discord" },
];
const workshops = [
    {
        name: "Intro to Hackathons",
        link: "https://docs.google.com/presentation/d/1r142lnKlA043jyYcFnjSFebxcm52usJ9MIVpLyUWQI4/edit?usp=sharing",
    },
    {
        name: "Intro to Web Dev",
        link: "https://docs.google.com/presentation/d/16moIOAhsbH5qlyeWv0xfH73XT_hk0TJ-b6xct3njT5U/edit?usp=sharing",
    },
    {
        name: "Intro to Git",
        link: "https://docs.google.com/presentation/d/17tD4eOPL54v6YPEZE57gkOrtEo9LA_r4U0bAOBRGRSo/edit?usp=sharing",
    },
    {
        name: "Intro to Hardware",
        link: "https://docs.google.com/presentation/d/1PGyzuwHUsFabeBiMDdyGySel6rtKnuKERMko81i1Lb0/edit?usp=sharing",
    },
];
---

<footer class="bg-[#161445] text-white">
    <div class="items-center lg:flex lg:justify-between">
        <div class="text-center opacity-90 lg:text-start">
            <p class="mb-0 text-2xl font-semibold">Sign up to our newsletter</p>
            <p class="font-light">
                Stay connected! Sign up for our mailing list for events,
                updates, and more.
            </p>
        </div>
        <form
            action="https://tamuhack.us21.list-manage.com/subscribe?u=6916895bdf09ac34cd4e523b9&id=669dbb893c"
            method="post"
            id="mc-embedded-subscribe-form"
            name="mc-embedded-subscribe-form"
            target="_blank"
            novalidate
            class="flex flex-col items-center justify-start gap-2 lg:flex-row lg:items-stretch"
        >
            <div
                class="flex w-full flex-row items-stretch justify-center gap-3 px-4 py-4 max-[27.5rem]:flex-col max-[27.5rem]:justify-stretch lg:flex-none lg:gap-5 lg:px-0"
            >
                <label for="mce-EMAIL" class="hidden">Email Address</label>
                <input
                    type="email"
                    autocomplete="email"
                    name="EMAIL"
                    placeholder="Enter your email address"
                    class="w-64 rounded-lg focus:outline-red border border-[#ffffff] bg-[rgba(217,217,217,0.09)] px-4 py-2 max-[27.5rem]:w-full 2xl:w-96"
                    id="mce-EMAIL"
                >
                <button type="submit" class="clear">
                    <input
                        type="submit"
                        value="Subscribe"
                        name="subscribe"
                        id="mc-embedded-subscribe"
                        class="h-full cursor-pointer rounded-lg border border-[#ffffff] px-4 py-2 text-base font-bold transition-colors duration-200 hover:bg-[#3D3590]"
                    >
                </button>
            </div>
            <!-- Mailchip bot prevention -->
            <div aria-hidden="true" class="absolute -left-[5000px]">
                <input
                    type="text"
                    name="b_6916895bdf09ac34cd4e523b9_669dbb893c"
                    autocomplete="off"
                    tabindex="-1"
                    value=""
                >
            </div>
        </form>
    </div>

    <div class="my-8 justify-between opacity-90 lg:my-16 xl:flex">
        <div class="xl:w-1/3">
            <p class="mb-8 text-3xl font-bold">HowdyHack 2026</p>
            <p class="font-base mb-8 text-xl">
                Website brought to you by the TAMUhack Design + Development
                Teams
            </p>
        </div>
        <div
            class="flex grow flex-wrap justify-start gap-12 lg:ml-12 lg:justify-end"
        >
            <LinkSection title="Hacker Resources" items={resources} />
            <LinkSection title="Socials" items={socials} />
            <LinkSection title="Workshops" items={workshops} />
        </div>
    </div>

    <div class="bottom-0">
        <div class="mx-8 h-[3px] rounded-xl bg-white/5"></div>
        <p class="py-3 text-sm font-light">
            Interested in sponsoring? Reach out to us at{' '}
            <a class="underline" href="mailto:sponsor@tamuhack.com">
                sponsor@tamuhack.com
            </a>.
        </p>
    </div>
</footer>

---
import { Image } from "astro:assets";
import TempBg from "@assets/temp-bg.png";
import FishLanding from "./FishLanding.astro";
---

<div id="fish-stage" class="relative w-full overflow-x-clip bg-blue-600">
  <div class="bg-blue-300 w-full aspect-100/33"></div>

  <div class="relative w-full aspect-100/200">
    <Image
      src={TempBg}
      alt=""
      aria-hidden="true"
      loading="eager"
      class="absolute top-0 left-0 w-full"
    />
  </div>
</div>
<FishLanding />

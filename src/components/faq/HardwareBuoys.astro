---
import How from "@assets/faq/buoys/faq-buoy-hw-how.png";
import Judging from "@assets/faq/buoys/faq-buoy-hw-judging.png";
import Software from "@assets/faq/buoys/faq-buoy-hw-sw.png";
import Want from "@assets/faq/buoys/faq-buoy-hw-want.png";
import When from "@assets/faq/buoys/faq-buoy-hw-when.png";
import Where from "@assets/faq/buoys/faq-buoy-hw-where.png";
import ChainHow from "@assets/faq/chain-how.png";
import ChainJudging from "@assets/faq/chain-judging.png";
import ChainSw from "@assets/faq/chain-sw.png";
import ChainWant from "@assets/faq/chain-want.png";
import ChainWhen from "@assets/faq/chain-when.png";
import ChainWhere from "@assets/faq/chain-where.png";
import Buoy from "./Buoy.astro";
---

<style>
.hardware-buoys {
    margin: 0;
    padding: 0;
    list-style: none;
}

@media (width < 64rem) {
    .hardware-buoys {
        order: 6;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
    }

    .hardware-buoys > :global([id^="buoy-"]) {
        /* Let flex centering handle buoys wider than the mobile scene. */
        margin-inline: 0;
    }
}
</style>

<ul class="hardware-buoys">
    <Buoy slug="judging" art={Judging} chain={ChainJudging} headingLevel={4}>
        <Fragment slot="question">When is hardware judging?</Fragment>
        <Fragment slot="answer">
            <p>
                Hardware judging will take place in-person at HowdyHack on
                {" "}<strong>Sunday, October 25th</strong>. Hardware and
                software judging occur at the same location and time. See our
                schedule for details.
            </p>
        </Fragment>
    </Buoy>

    <Buoy slug="how" art={How} chain={ChainHow} headingLevel={4}>
        <Fragment slot="question"
            >How does the hardware track at HowdyHack work?</Fragment
        >
        <Fragment slot="answer">
            <p>
                The hardware track begins on{" "}
                <strong>Monday, October 19th,</strong>{" "}
                and continues through the week leading up to HowdyHack.
                Participants will collaboratively design and build
                hardware-based solutions to be judged at the event. All
                logistics can be found in the
                <a
                    href="https://docs.google.com/document/d/1XbRJmAOIaSmEmf1iT0peJe9mKLdmfs8QvcKQcY0H79Y/edit?tab=t.0#heading=h.pnq18snjv4zj"
                    target="_blank"
                    >Hardware Track Guide.</a
                >
            </p>
            <p>
                Hardware hackers are still{" "}
                <strong>required to check in</strong>{" "}
                to HowdyHack on October 24th and are encouraged to stay for
                food, swag, and day-of activities.
            </p>
        </Fragment>
    </Buoy>

    <Buoy slug="want" art={Want} chain={ChainWant} headingLevel={4}>
        <Fragment slot="question"
            >I want to participate, but I don't have any hardware. What should I
            do?</Fragment
        >
        <Fragment slot="answer">
            <p>
                TAMUhack will provide dedicated hardware components for hackers
                on a first-come-first-serve basis. Details and a list of
                components can be found on the
                <a
                    href="https://docs.google.com/document/d/1XbRJmAOIaSmEmf1iT0peJe9mKLdmfs8QvcKQcY0H79Y/edit?tab=t.0#heading=h.pnq18snjv4zj"
                    target="_blank"
                    >Hardware Track Guide.</a
                >
            </p>
            <p>
                <strong>NOTE:{" "}</strong>
                Hackers are not limited to the resources we provide; using
                personal/external hardware is allowed.
            </p>
        </Fragment>
    </Buoy>

    <Buoy slug="sw" art={Software} chain={ChainSw} headingLevel={4}>
        <Fragment slot="question"
            >Can I participate in both the software and hardware tracks?</Fragment
        >
        <Fragment slot="answer">
            <p>
                At this time, a team can only participate in one track, either
                software or hardware. The tracks will be judged separately by
                specialists in the respective field.
            </p>
        </Fragment>
    </Buoy>

    <Buoy slug="when" art={When} chain={ChainWhen} headingLevel={4}>
        <Fragment slot="question"
            >When can I start working on my hardware project?</Fragment
        >
        <Fragment slot="answer">
            <p>
                Teams may begin working asynchronously on
                <strong>October 19th</strong>. Hardware participants are still
                required to check in to the event on
                <strong>October 24th</strong>. Hardware judging will take place
                in person on <strong>October 25th</strong>.
            </p>
        </Fragment>
    </Buoy>

    <Buoy slug="where" art={Where} chain={ChainWhere} headingLevel={4}>
        <Fragment slot="question"
            >Where can I specify that I want to participate in the hardware
            track?</Fragment
        >
        <Fragment slot="answer">
            <p>
                There is a question on the application that asks if you want to
                participate in the hardware track. If you change your mind
                before applications close, you can log back in and edit your
                application. Similar to software, hackers are allowed to apply
                and work in teams of up to 4.
            </p>
        </Fragment>
    </Buoy>
</ul>

---
import SeaweedLeft from "@assets/faq/seaweed-left.svg";
import SeaweedRight from "@assets/faq/seaweed-right.svg";
---

<!-- ts isnt crazy i just have the same formatting as the gradient-->
<style>
.faq-seaweed {
    top: calc(var(--faq-width) * 0.46582);
    height: calc(var(--faq-width) * 6.431641);
}

.faq-seaweed-left {
    left: calc(var(--faq-width) * -0.186523);
    width: calc(var(--faq-width) * 0.491211);
}

.faq-seaweed-right {
    right: calc(var(--faq-width) * -0.199219);
    width: calc(var(--faq-width) * 0.560547);
    transform: scaleX(-1);
}

.seaweed-svg {
    display: block;
    width: 100%;
    height: 100%;
}

.faq-seaweed-wide {
    display: none;
    left: calc(50% - var(--faq-width) * 1.671973);
    top: calc(var(--faq-width) * 0.177637);
    width: calc(var(--faq-width) * 3.354688);
    height: calc(var(--faq-width) * 6.786328);
    background-repeat: no-repeat;
    background-size: 100% 100%;
}

/* widescreen stuff */
@media (width >= 96rem) {
    .faq-seaweed-left,
    .faq-seaweed-right {
        display: none;
    }

    .faq-seaweed-wide {
        display: block;
        background-image: url("../../assets/faq/seaweed-wide.svg");
    }
}

/* mobile stuff */
@media (width < 64rem) {
    .faq-seaweed {
        top: calc(var(--faq-width) * 0.259778);
    }
}
</style>

<div
    aria-hidden="true"
    class="faq-seaweed faq-seaweed-left pointer-events-none absolute z-1"
>
    <SeaweedLeft class="seaweed-svg" />
</div>
<div
    aria-hidden="true"
    class="faq-seaweed faq-seaweed-right pointer-events-none absolute z-1"
>
    <SeaweedRight class="seaweed-svg" />
</div>
<div
    aria-hidden="true"
    class="faq-seaweed-wide pointer-events-none absolute z-1"
></div>

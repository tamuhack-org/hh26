---
import Attend from "@assets/faq/buoys/attend.svg";
import Cost from "@assets/faq/buoys/cost.svg";
import Deadline from "@assets/faq/buoys/deadline.svg";
import Experience from "@assets/faq/buoys/experience.svg";
import MoreQs from "@assets/faq/buoys/more-qs.svg";
import Msc from "@assets/faq/buoys/msc.svg";
import Plagiarism from "@assets/faq/buoys/plagiarism.svg";
import Teams from "@assets/faq/buoys/teams.svg";
import Waitlist from "@assets/faq/buoys/waitlist.svg";
import Workshops from "@assets/faq/buoys/workshops.svg";
import Buoy from "./Buoy.astro";
import { BUOYS } from "./buoys";

/* ts here because svg imports must be static or sum */
const ART: Record<string, unknown> = {
    attend: Attend,
    cost: Cost,
    deadline: Deadline,
    experience: Experience,
    moreQs: MoreQs,
    msc: Msc,
    plagiarism: Plagiarism,
    teams: Teams,
    waitlist: Waitlist,
    workshops: Workshops,
};
---

{BUOYS.map((buoy) => <Buoy buoy={buoy} art={ART[buoy.slug]} />)}

        top: -13.238146%;
        width: 3.15875rem;
    }

    #buoy-plagiarism {
        margin-bottom: 6.0125rem;
    }

    #chain-plagiarism {
        left: 46.06466%;
        top: -16.388283%;
        width: 2.16625rem;
    }

    #buoy-waitlist {
        margin-bottom: 5.0125rem;
    }

    #chain-waitlist {
        left: 43.795958%;
        top: -12.91136%;
        width: 2.61375rem;
    }

    #buoy-more-qs {
        margin-bottom: 2.6875rem;
    }

    #chain-more-qs {
        left: 40.007077%;
        top: -15.725048%;
        width: 1.98125rem;
    }

    /* Mobile hardware gaps: each margin-bottom controls the following space. */
    #buoy-judging {
        margin-top: 2rem;
        margin-bottom: 2.039rem;
    }

    #buoy-how {
        margin-bottom: 2.039rem;
    }

    #buoy-want {
        margin-bottom: 0.039rem;
    }

    #buoy-sw {
        margin-bottom: 0.039rem;
    }

    #buoy-when {
        margin-bottom: 1.039rem;
    }

    #buoy-where {
        margin-bottom: 2.664rem;
    }

    .buoy-chain-mobile {
        display: block;
    }

    [id^="buoy-"] {
        order: 1;
        position: relative;
        width: calc(var(--art-w) * var(--m-base));
        aspect-ratio: var(--art-w) / var(--art-h);
        margin: 0 auto calc(var(--faq-width) * 0.111);
    }

    .buoy-art {
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
    }

    .buoy-q {
        left: calc((var(--q-cx) - var(--art-l)) / var(--art-w) * 100%);
        top: calc((var(--q-top) - var(--art-t)) / var(--art-h) * 100%);
        width: calc(var(--q-w) / var(--art-w) * 100%);
        font-size: calc(var(--q-size) * var(--m-base) / 1024);
    }

    .buoy-a {
        left: calc((var(--a-cx) - var(--art-l)) / var(--art-w) * 100%);
        top: calc((var(--a-top) - var(--art-t)) / var(--art-h) * 100%);
        width: calc(var(--a-w) / var(--art-w) * 100%);
        font-size: calc(var(--m-base) * 16 / 1024);
    }
}
</style>

<li id={`buoy-${slug}`}>
    <div class="buoy-art" aria-hidden="true">
        <div class="buoy-bleed">
            <Picture
                src={art}
                formats={["avif", "webp"]}
                quality={80}
                alt=""
                width={Math.round(art.width / 2)}
                class="buoy-img"
            />
        </div>
        {chain && (
            <Image
                id={`chain-${slug}`}
                src={chain}
                format="webp"
                quality={90}
                alt=""
                class:list={["buoy-chain", { "buoy-chain-mobile": chainMobileOnly }]}
            />
        )}
    </div>
    <QuestionHeading class="buoy-q"><slot name="question" /></QuestionHeading>
    <div class="buoy-a"><slot name="answer" /></div>
</li>

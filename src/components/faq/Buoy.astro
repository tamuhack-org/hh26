/* widescreen stuff */
@media (width >= 64rem) {
    #buoy-judging,
    #buoy-how,
    #buoy-want,
    #buoy-sw,
    #buoy-when,
    #buoy-where {
        --hardware-info-offset: var(--hardware-info-space);
    }

    #buoy-how,
    #buoy-sw,
    #buoy-where {
        --hardware-column-offset: -4rem;
    }

    #buoy-judging,
    #buoy-want,
    #buoy-when {
        --hardware-column-offset: 4rem;
        --hardware-column-drop: 1.125rem;
    }

    #buoy-judging {
        --hardware-column-offset: 0.6rem;
    }

    #buoy-sw {
        --hardware-row-offset: 5rem;
        --hardware-column-offset: -2.2rem;
    }

    #buoy-where {
        --hardware-row-offset: 9rem;
        --hardware-column-offset: 1rem;
    }

    #buoy-want {
        --hardware-row-offset: 6rem;
    }

    #buoy-when {
        --hardware-row-offset: 12rem;
        --hardware-column-offset: 5.5rem;
    }

    .buoy-art,
    .buoy-q,
    .buoy-a {
        transform: translate(
            var(--hardware-column-offset, 0rem),
            calc(
                var(--hardware-row-offset, 0rem) +
                var(--hardware-column-drop, 0rem) +
                var(--hardware-info-offset, 0rem)
            )
        );
    }
}

/* mobile stuff */
@media (width < 64rem) {
    /* Mobile: each buoy controls its own following gap and chain placement. */
    #buoy-deadline {
        margin-top: 4rem;
        margin-bottom: 6.0125rem;
    }

    #chain-deadline {
        left: 43.442851%;
        top: -22.238146%;
        width: 3.15875rem;
    }

    #buoy-experience {
        margin-bottom: 6.0125rem;
    }


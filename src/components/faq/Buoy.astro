/* widescreen stuff */
@media (width >= 64rem) {
    #buoy-how,
    #buoy-sw,
    #buoy-where {
        --hardware-column-offset: -4rem;
    }

    #buoy-judging,
    #buoy-want,
    #buoy-when {
        --hardware-column-offset: 4rem;
    }

    #buoy-sw,
    #buoy-want {
        --hardware-row-offset: 2rem;
    }

    #buoy-where,
    #buoy-when {
        --hardware-row-offset: 4rem;
    }

    .buoy-art,
    .buoy-q,
    .buoy-a {
        transform: translate(
            var(--hardware-column-offset, 0rem),
            var(--hardware-row-offset, 0rem)
        );
    }
}

/* mobile stuff */
@media (width < 64rem) {
    [id^="buoy-"] {
        order: 1;
        position: relative;
        width: calc(var(--art-w) * var(--m-base));
        aspect-ratio: var(--art-w) / var(--art-h);
        margin: 0 auto calc(var(--faq-width) * 0.111);
    }

    .buoy-art {
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
    }

    .buoy-q {
        left: calc((var(--q-cx) - var(--art-l)) / var(--art-w) * 100%);
        top: calc((var(--q-top) - var(--art-t)) / var(--art-h) * 100%);
        width: calc(var(--q-w) / var(--art-w) * 100%);
        font-size: calc(var(--q-size) * var(--m-base) / 1024);
    }

    .buoy-a {
        left: calc((var(--a-cx) - var(--art-l)) / var(--art-w) * 100%);
        top: calc((var(--a-top) - var(--art-t)) / var(--art-h) * 100%);
        width: calc(var(--a-w) / var(--art-w) * 100%);
        font-size: calc(var(--m-base) * 16 / 1024);
    }
}
</style>

<div id={`buoy-${slug}`}>
    <div class="buoy-art" aria-hidden="true">
        <div class="buoy-bleed">
            <Picture
                src={art}
                formats={["avif", "webp"]}
                quality={80}
                alt=""
                width={Math.round(art.width / 2)}
                class="buoy-img"
            />
        </div>
    </div>
    <p class="buoy-q"><slot name="question" /></p>
    <div class="buoy-a"><slot name="answer" /></div>
</div>

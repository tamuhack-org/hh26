---
import { Image, Picture } from "astro:assets";

interface Props {
    slug: string;
    art: ImageMetadata;
    chain?: ImageMetadata;
    chainMobileOnly?: boolean;
    headingLevel?: 3 | 4;
}

const {
    slug,
    art,
    chain,
    chainMobileOnly = false,
    headingLevel = 3,
} = Astro.props;
const QuestionHeading = `h${headingLevel}`;
---

<style>
/* !!!!!! to clarify for the ts styles component, you can pull the exact positions from figma which is why i use a lot of calc to put stuff where it goes */
.buoy-art {
    position: absolute;
    z-index: 10;
    left: calc(var(--faq-width) * var(--art-l));
    top: calc(var(--faq-width) * var(--art-t));
    width: calc(var(--faq-width) * var(--art-w));
    height: calc(var(--faq-width) * var(--art-h));
}

.buoy-bleed {
    position: absolute;
    inset: var(--bleed-t) var(--bleed-r) var(--bleed-b) var(--bleed-l);
}

.buoy-img {
    display: block;
    width: 100%;
    height: 100%;
}

.buoy-chain {
    position: absolute;
    left: var(--chain-left);
    top: var(--chain-top);
    width: var(--chain-width);
    height: auto;
    pointer-events: none;
}

.buoy-chain-mobile {
    display: none;
}

.buoy-q,
.buoy-a {
    font-family: var(--font-poppins), sans-serif;
    position: absolute;
    z-index: 20;
    margin: 0;
    translate: -50% 0;
    text-align: center;
    text-wrap: pretty;
    letter-spacing: 0.02em;
}

.buoy-q {
    font-family: var(--font-poppins), sans-serif;
    left: calc(var(--faq-width) * var(--q-cx));
    top: calc(var(--faq-width) * var(--q-top));
    width: calc(var(--faq-width) * var(--q-w));
    color: #fff;
    font-size: calc(var(--faq-width) * var(--q-size) / 1024);
    font-weight: 700;
    line-height: var(--q-leading, inherit);
    text-shadow: 1px 1px 3px rgb(35 27 121 / 0.6);
}

.buoy-a {
    left: calc(var(--faq-width) * var(--a-cx));
    top: calc(var(--faq-width) * var(--a-top));
    width: calc(var(--faq-width) * var(--a-w));
    color: #261d5f;
    font-size: calc(var(--faq-width) * 16 / 1024);
    font-weight: 400;
    line-height: var(--a-leading, inherit);
}

.buoy-a :global(p) {
    margin: 0;
}

.buoy-a :global(p + p) {
    margin-top: var(--paragraph-gap, 1em);
}

.buoy-a :global(a) {
    color: inherit;
    text-decoration: underline;
}

.buoy-a :global(strong) {
    font-weight: 600;
}


---
import { getImage, Picture } from "astro:assets";
import BuoyLine from "@assets/faq/faq-buoy-line.png";
import MobileBuoyLine from "@assets/faq/faq-mobile-buoy-line.png";

const OptimizedMobileBuoyLine = await getImage({ src: MobileBuoyLine, format: "avif", quality: 80 });
---

<style>
.faq-buoy-line {
    left: 50%;
    translate: -50% 0;
    top: calc(var(--faq-width) * 4.078691);
    width: calc(var(--faq-width) * 1.327148);
    height: calc(var(--faq-width) * 0.133789);
}

.faq-buoy-line-img {
    display: block;
    width: 100%;
    height: 100%;
}

/* widescreen stuff */

/* mobile stuff */
@media (width < 64rem) {
    .faq-buoy-line {
        order: 3;
        position: static;
        translate: none;
        width: var(--faq-width);
        height: calc(var(--faq-width) * 0.352778);
        margin-top: 2rem;
        background-image: var(--mobile-buoy-line-image);
        background-repeat: no-repeat;
        background-size: 100% 100%;
    }

    .faq-buoy-line-img {
        display: none;
    }
}
</style>

<div
    aria-hidden="true"
    class="faq-buoy-line pointer-events-none absolute z-5"
    style={`--mobile-buoy-line-image: url('${OptimizedMobileBuoyLine.src}');`}
>
    <Picture
        src={BuoyLine}
        formats={["avif", "webp"]}
        quality={80}
        alt=""
        width={Math.round(BuoyLine.width / 2)}
        class="faq-buoy-line-img"
    />
</div>

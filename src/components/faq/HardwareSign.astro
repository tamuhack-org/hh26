---
import { getImage, Picture } from "astro:assets";
import HardwareSign from "@assets/faq/faq-hardware-sign.png";
import MobileHardwareSign from "@assets/faq/faq-mobile-hardware-sign.png";

const OptimizedMobileHardwareSign = await getImage({
    src: MobileHardwareSign,
    format: "avif",
    quality: 80,
});
---

<style>
.faq-hardware {
    left: calc(var(--faq-width) * 0.086914);
    top: calc(var(--faq-width) * 4.206055);
    width: calc(var(--faq-width) * 0.913086);
    height: calc(var(--faq-width) * 0.246094);
}

.faq-hardware-img {
    display: block;
    width: 100%;
    height: 100%;
}

/* widescreen stuff */

/* mobile stuff */
@media (width < 64rem) {
    .faq-hardware {
        order: 4;
        position: static;
        width: var(--faq-width);
        height: calc(var(--faq-width) * 0.416667);
        margin-top: calc(var(--faq-width) * -0.175);
        background-image: var(--mobile-hardware-sign-image);
        background-repeat: no-repeat;
        background-size: 100% 100%;
    }

    .faq-hardware-img {
        display: none;
    }
}
</style>

<div
    class="faq-hardware pointer-events-none absolute z-10"
    role="img"
    aria-label="Hardware"
    style={`--mobile-hardware-sign-image: url('${OptimizedMobileHardwareSign.src}');`}
>
    <Picture
        src={HardwareSign}
        formats={["avif", "webp"]}
        quality={80}
        alt=""
        width={HardwareSign.width}
        class="faq-hardware-img"
    />
</div>

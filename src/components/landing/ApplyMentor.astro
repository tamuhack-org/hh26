---
import { Picture } from "astro:assets";
import ApplyBoard from "@assets/landing/apply-board.png";
import MentorBoard from "@assets/landing/mentor-board.png";
---

<div class="flex mr-[17%] mb-[30%] items-end">
  <a
    href="https://start.tamuhack.org"
    aria-label="Apply to TAMUhack"
    class="cta-board mr-[-12%] z-5"
  >
    <Picture
      src={ApplyBoard}
      formats={["avif", "webp"]}
      quality={80}
      alt=""
      aria-hidden="true"
      loading="eager"
      width={199}
      sizes="(min-width: 96rem) 12.4446rem, 12.963168vw"
      class="w-[calc(var(--landing-width)*0.12963168)]"
    />
  </a>
  <a
    href="https://start.tamuhack.org"
    aria-label="Mentor at TAMUhack"
    class="cta-board"
  >
    <Picture
      src={MentorBoard}
      formats={["avif", "webp"]}
      quality={80}
      alt=""
      aria-hidden="true"
      loading="eager"
      width={152}
      sizes="(min-width: 96rem) 9.5rem, 9.863vw"
      class="w-[calc(var(--landing-width)*0.0986328)]"
    />
  </a>
</div>

<style>
@media (min-width: 64rem) and (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) {
  .cta-board {
    transition: transform 160ms ease-out;
  }

  .cta-board:hover {
    transform: translateY(-5%);
  }
}
</style>

---
import { Picture } from "astro:assets";
import FlyingFish from "@assets/landing/flying-fish.png";

const fishPath =
    "M240.411,310.041 C404.189,240.804 570.665,220.34 734.538,289.22 893.296,355.95 1056.809,532.363 985.984,750";
---

<div class="relative mx-auto w-full aspect-1024/563">
    <svg
        class="absolute top-0 left-0 w-full h-full"
        viewBox="0 0 1024 563"
        preserveAspectRatio="none"
        aria-hidden="true"
    >
        <path id="fish-motion-path" d={fishPath} fill="none" />
    </svg>
    <Picture
        id="fish"
        src={FlyingFish}
        formats={["avif", "webp"]}
        quality={80}
        alt=""
        aria-hidden="true"
        loading="eager"
        fetchpriority="high"
        width={891}
        widths={[308, 480, 615, 640, 750, 828, 891, 960, 1080, 1280, 1668, 1782]}
        sizes="(min-width: 96rem) 55.6875rem, (min-width: 64rem) 58vw, 19.208rem"
        class="w-80/100 lg:w-58/100 max-w-none"
    />
</div>

<style>
#fish {
    position: absolute;
    opacity: 1;
    left: 0;
    top: -1rem;
    rotate: -5deg;
    @media (min-width: 64rem) {
        left: calc(var(--landing-scene-width) * -0.047);
        top: calc(var(--landing-scene-width) * 0.153);

        @media (prefers-reduced-motion: no-preference) {
            opacity: 0;
            left: 0;
            top: 0;
            rotate: 0deg;
        }
    }
}
</style>

<script>
import { gsap } from "gsap";
import { MotionPathPlugin } from "gsap/MotionPathPlugin";
import { ScrollTrigger } from "gsap/ScrollTrigger";
import { MEDIA } from "../../media";

gsap.registerPlugin(MotionPathPlugin, ScrollTrigger);

gsap.matchMedia().add(`${MEDIA.desktop} and ${MEDIA.motionSafe}`, () => {
    const tl = gsap.timeline({
        scrollTrigger: {
            trigger: "#landing",
            start: "top top",
            end: () => `+=${window.innerWidth * 0.4}`,
            scrub: 1,
            invalidateOnRefresh: true,
        },
    });

    tl.to("#fish", {
        duration: 1,
        ease: "none",
        immediateRender: true,
        motionPath: {
            path: "#fish-motion-path",
            align: "#fish-motion-path",
            start: 0,
            end: 1,
            autoRotate: 18,
            alignOrigin: [0.5, 0.31],
        },
    });

    tl.to(
        "#fish",
        {
            ease: "none",
            duration: 0.25,
            scale: 0.5,
            transformOrigin: "50% 31%",
        },
        0.84,
    );

    gsap.set("#fish", { autoAlpha: 1 });

    return () => {
        tl.kill();
        gsap.set("#fish", { clearProps: "all" });
    };
});
</script>

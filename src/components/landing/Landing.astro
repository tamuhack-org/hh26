---
import { Image } from "astro:assets";
import FishLanding from "./FishLanding.astro";
import Wave from "./Wave.astro";
---

<section id="landing" class="relative w-full overflow-x-clip bg-[#29CDB4]">
  <div
    class="absolute inset-x-0 aspect-1024/763"
    style="background: radial-gradient(98.58% 50.38% at 26.71% 0%, #FCE3A5 0%, #7FDAB0 44.71%, #2CD0B4 78.85%, #29CDB4 99.04%);"
  ></div>
  <Wave />
  <div id="inner-assets" class="mx-auto w-full max-w-500">
    <!-- this is where we would put all the assets constrained by width -->
    <!-- in other words, everything BUT the waves -->
    <FishLanding />
  </div>
</section>

---
import { Picture } from "astro:assets";
import SandFront from "@assets/landing/sand-front.png";
import SandTree from "@assets/landing/sand-tree.png";
import ApplyMentor from "./ApplyMentor.astro";
import FishLanding from "./FishLanding.astro";
import JellySvg from "./JellySvg.astro";
import Wave from "./Wave.astro";
---

<style>
#landing {
  --landing-width: min(100vw, var(--widescreen-breakpoint));
  --wave-end-height: calc(var(--landing-width) * 0.7518556);

  grid-template-rows: calc(var(--landing-width) * 0.35) var(--wave-end-height);
}

.landing-gradient {
  height: calc(var(--landing-width) * 0.71875);
  background: radial-gradient(
    calc(var(--landing-width) * 0.9858) calc(var(--landing-width) * 0.362106) at
      max(
        calc(var(--landing-width) * 0.2671),
        calc(50vw - calc(var(--landing-width) * 0.2329))
      )
      0,
    #fce3a5 0%,
    #7fdab0 44.71%,
    #2cd0b4 78.85%,
    #29cdb4 99.04%
  );
}
</style>

<section
  id="landing"
  aria-labelledby="landing-title"
  class="relative isolate grid w-full overflow-x-clip"
>
  <h2 class="sr-only" id="landing-title">Landing</h2>
  <div
    aria-hidden="true"
    class="landing-gradient pointer-events-none absolute inset-x-0 top-0 z-0"
  ></div>
  <div class="pointer-events-none relative row-start-2">
    <Wave />
  </div>
  <div
    id="inner-assets"
    class="row-start-1 mx-auto grid w-full max-w-(--widescreen-breakpoint) grid-cols-2"
  >
    <!-- this is where we would put all the assets constrained by width -->
    <!-- in other words, everything BUT the waves -->

    <div
      class="pointer-events-none relative z-10 row-start-1 col-start-1 col-span-2"
    >
      <Picture
        src={SandTree}
        formats={["avif", "webp"]}
        quality={80}
        alt=""
        aria-hidden="true"
        loading="eager"
        fetchpriority="high"
        class="w-130/100 max-w-none"
      />
    </div>
    <div class="relative z-20 row-start-1 col-start-1">
      <JellySvg />
    </div>

    <div
      class="relative z-10 row-start-1 col-start-2 flex items-end justify-end"
    >
      <ApplyMentor />
    </div>

    <div
      class="pointer-events-none relative z-10 col-span-2 row-start-1 col-start-1 self-end"
    >
      <Picture
        src={SandFront}
        formats={["avif", "webp"]}
        quality={80}
        alt=""
        aria-hidden="true"
        loading="eager"
        class="w-full"
      />
    </div>

    <div
      class="pointer-events-none relative z-30 col-start-1 col-span-2 row-start-1"
    >
      <FishLanding />
    </div>
  </div>
</section>

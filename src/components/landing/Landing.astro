---
import { Picture } from "astro:assets";
import ApplyBoard from "@assets/landing/apply-board.png";
import MentorBoard from "@assets/landing/mentor-board.png";
import SandFront from "@assets/landing/sand-front.png";
import SandTree from "@assets/landing/sand-tree.png";
import FishLanding from "./FishLanding.astro";
import Wave from "./Wave.astro";
---

<style>
#landing {
  --landing-width: min(100vw, var(--widescreen-breakpoint));
  grid-template-rows: calc(var(--landing-width) * 0.359375) auto;
}

.landing-gradient {
  height: calc(var(--landing-width) * 0.71875);
  background: radial-gradient(
    calc(var(--landing-width) * 0.9858) calc(var(--landing-width) * 0.362106) at
      max(
        calc(var(--landing-width) * 0.2671),
        calc(50vw - calc(var(--landing-width) * 0.2329))
      )
      0,
    #fce3a5 0%,
    #7fdab0 44.71%,
    #2cd0b4 78.85%,
    #29cdb4 99.04%
  );
}
</style>

<section
  id="landing"
  aria-labelledby="landing-title"
  class="relative isolate grid w-full overflow-x-clip"
>
  <h2 class="sr-only" id="landing-title">Landing</h2>
  <div
    aria-hidden="true"
    class="landing-gradient absolute inset-x-0 top-0 z-0"
  ></div>
  <div class="relative row-start-2">
    <Wave />
  </div>
  <div
    id="inner-assets"
    class="row-start-1 mx-auto grid w-full max-w-(--widescreen-breakpoint) grid-cols-2"
  >
    <!-- this is where we would put all the assets constrained by width -->
    <!-- in other words, everything BUT the waves -->

    <div class="relative z-10 row-start-1 col-start-1 col-span-2">
      <Picture
        src={SandTree}
        formats={["avif", "webp"]}
        quality={80}
        alt=""
        aria-hidden="true"
        loading="eager"
        fetchpriority="high"
        class="w-130/100 max-w-none"
      />
    </div>

    <div
      class="relative z-10 row-start-1 col-start-2 flex items-end justify-end"
    >
      <div class="flex mr-[17%] mb-[32%] items-end">
        <div class="mr-[-10%] z-5">
          <Picture
            src={ApplyBoard}
            formats={["avif", "webp"]}
            quality={80}
            alt=""
            aria-hidden="true"
            loading="eager"
            class="w-[calc(var(--landing-width)*0.13183)]"
          />
        </div>
        <div>
          <Picture
            src={MentorBoard}
            formats={["avif", "webp"]}
            quality={80}
            alt=""
            aria-hidden="true"
            loading="eager"
            class="w-[calc(var(--landing-width)*0.0986328)]"
          />
        </div>
      </div>
    </div>

    <div class="relative z-10 col-span-2 row-start-1 col-start-1 self-end">
      <Picture
        src={SandFront}
        formats={["avif", "webp"]}
        quality={80}
        alt=""
        aria-hidden="true"
        loading="eager"
        fetchpriority="high"
        class="w-full"
      />
    </div>

    <div class="relative z-30 col-start-1 col-span-2 row-start-1">
      <FishLanding />
    </div>
  </div>
</section>

---
import { Picture } from "astro:assets";
import SandFront from "@assets/landing/sand-front.png";
import SandTree from "@assets/landing/sand-tree.png";
import SandTreeMobile from "@assets/landing/sand-tree-mobile.png";
import ApplyMentor from "./ApplyMentor.astro";
import FishLanding from "./FishLanding.astro";
import JellySvg from "./JellySvg.astro";
import Wave from "./Wave.astro";
import DateLoc from "./DateLoc.astro"

import Apply from "@assets/landing/apply-mobile.png";
import Mentor from "@assets/landing/mentor-mobile.png";
---

<style>
#landing {
  --landing-width: min(100vw, var(--widescreen-breakpoint));
  --scene-width: 70rem;
  --wave-end-height: calc(var(--scene-width) * 0.7518556);

  --gradient-x: calc(50vw - var(--scene-width) * 0.15); /*keeps gradient visually fixed*/

  grid-template-rows: calc(var(--scene-width) * 0.35) var(--wave-end-height);
}

.landing-gradient {
  height: calc(var(--scene-width) * 0.71875);
  background: radial-gradient(
    calc(var(--scene-width) * 0.9858) calc(var(--scene-width) * 0.362106) at
      var(--gradient-x)
      0,
    #fce3a5 0%,
    #7fdab0 44.71%,
    #2cd0b4 78.85%,
    #29cdb4 99.04%
  );
}

@media (min-width: 64rem) {
  #landing {
    --scene-width: var(--landing-width);
    --gradient-x: max(
      calc(var(--scene-width) * 0.2671),
      calc(50vw - calc(var(--scene-width) * 0.2329))
    );
  }
}
</style>

<section
  id="landing"
  aria-labelledby="landing-title"
  class="relative isolate grid w-full overflow-x-clip"
>
  <h2 class="sr-only" id="landing-title">Landing</h2>
  <div
    aria-hidden="true"
    class="landing-gradient pointer-events-none absolute inset-x-0 top-0 z-0"
  ></div>
  <div class="pointer-events-none relative row-start-2">
    <Wave />
  </div>
  <div
    id="inner-assets"
    class="row-start-1 mx-auto grid max-w-xs w-full lg:max-w-(--widescreen-breakpoint) grid-cols-1 lg:grid-cols-2 max-lg:content-start"
  >
    <!-- this is where we would put all the assets constrained by width -->
    <!-- in other words, everything BUT the waves -->

    <div
      class="pointer-events-none hidden lg:block relative z-10 row-start-1 col-start-1 col-span-2"
    >
      <Picture
        src={SandTree}
        formats={["avif", "webp"]}
        quality={80}
        alt=""
        aria-hidden="true"
        loading="eager"
        fetchpriority="high"
        width={1997}
        sizes="(min-width: 96rem) 124.8125rem, 130vw"
        class="w-130/100 max-w-none"
      />
    </div>
    <div class="relative z-20 pt-3 px-3 mt-20 lg:mt-0 row-start-1 col-start-1 ">
      <JellySvg />
    </div>
    <div class="z-5 flex justify-center items-center">
      <DateLoc />
    </div>
    <div class="relative flex items-center lg:hidden mt-2 gap-4 p-2 z-20 place-self-center">
      <a
      href="https://start.tamuhack.org"
      aria-label="Apply to TAMUhack"
      class="z-5"
      >
        <Picture
            src={Apply}
            formats={["avif", "webp"]}
            quality={80}
            alt=""
            aria-hidden="true"
            loading="eager"
            class=""
          />
      </a>
      <a
      href="https://start.tamuhack.org"
      aria-label="Mentor at TAMUhack"
      class="z-5"
      >
        <Picture
          src={Mentor}
          formats={["avif", "webp"]}
          quality={80}
          alt=""
          aria-hidden="true"
          loading="eager"
          class=""
        />
      </a>
    </div>
    <div
      class="relative z-10 hidden lg:flex row-start-1 col-start-2 items-end justify-end"
    >
      <ApplyMentor />
    </div>

    <div
      class="pointer-events-none hidden lg:block relative z-10 col-span-2 row-start-1 col-start-1 self-end"
    >
      <Picture
        src={SandFront}
        formats={["avif", "webp"]}
        quality={80}
        alt=""
        aria-hidden="true"
        loading="eager"
        width={1536}
        sizes="(min-width: 96rem) 96rem, 100vw"
        class="w-full"
      />
    </div>

    <div
      class="pointer-events-none z-30 absolute left-1/2 -translate-x-1/2 top-[calc(var(--scene-width)*0.30)] w-[calc(var(--scene-width)*0.343)] lg:static lg:left-auto lg:translate-x-0 lg:top-auto lg:w-auto lg:col-start-1 lg:col-span-2 lg:row-start-1"
    >
      <FishLanding />
    </div>
    <div
      class="pointer-events-none lg:hidden absolute left-[calc(50%+var(--scene-width)*0.02)] -translate-x-1/2 top-[calc(var(--scene-width)*0.19)] z-1"
    >
      <Picture
        src={SandTreeMobile}
        formats={["avif", "webp"]}
        quality={80}
        alt=""
        aria-hidden="true"
        loading="eager"
        fetchpriority="high"
        width={1997}
        sizes=""
        class="w-[calc(var(--scene-width)*0.4)] max-w-none"
      />
    </div>

  </div>
</section>

---
import { Image } from "astro:assets";
import Wave1 from "@assets/landing/wave-1.png";
import Wave2 from "@assets/landing/wave-2.png";
import Wave3 from "@assets/landing/wave-3.png";
import Wave4 from "@assets/landing/wave-4.png";
---

<style>
#wave-container {
  background-repeat: repeat-x;
}
</style>

<div class="relative w-full h-screen overflow-visible" id="wave-container">
  <div
    id="layer-1"
    class="absolute top-50 w-full h-48"
    style={`background-image: url('${Wave4.src}'); background-repeat: repeat-x; background-position: 15%; background-size: auto 100%;`}
  ></div>

  <div
    id="layer-2"
    class="absolute top-75 w-full h-48"
    style={`background-image: url('${Wave3.src}'); background-repeat: repeat-x; background-size: auto 100%;`}
  ></div>

  <div
    id="layer-3"
    class="absolute top-105 w-full h-48"
    style={`background-image: url('${Wave2.src}'); background-repeat: repeat-x; background-size: auto 100%;`}
  ></div>

  <div
    id="layer-4"
    class="absolute top-130 w-full h-48"
    style={`background-image: url('${Wave1.src}'); background-repeat: repeat-x; background-size: auto 100%;`}
  ></div>
</div>

<script>
import { gsap } from "gsap";
import { MotionPathHelper } from "gsap/MotionPathHelper";
import { MotionPathPlugin } from "gsap/MotionPathPlugin";
import { ScrollTrigger } from "gsap/ScrollTrigger";

gsap.registerPlugin(MotionPathHelper, MotionPathPlugin, ScrollTrigger);

const layers = [
  { id: "#layer-1", yPercent: -20 },
  { id: "#layer-2", yPercent: -170 },
  { id: "#layer-3", yPercent: -280 },
  { id: "#layer-4", yPercent: -330 },
];

layers.forEach(({ id, yPercent }) => {
  gsap.to(id, {
    yPercent,
    ease: "none",
    scrollTrigger: {
      trigger: "#wave-container",
      start: "top top",
      end: "+=690",
      scrub: 0.1,
      markers: true,
    },
  });
});
</script>

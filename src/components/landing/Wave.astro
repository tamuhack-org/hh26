---
import { getImage, Image } from "astro:assets";
import DateWave from "@assets/landing/date-wave.png";
import LocationWave from "@assets/landing/location-wave.png";
import Wave1 from "@assets/landing/wave-1.png";
import Wave2 from "@assets/landing/wave-2.png";
import Wave3 from "@assets/landing/wave-3.png";
import Wave4 from "@assets/landing/wave-4.png";

const [OptimizedWave1, OptimizedWave2, OptimizedWave3, OptimizedWave4] =
  await Promise.all([
    getImage({ src: Wave1, format: "avif", quality: 80 }),
    getImage({ src: Wave2, format: "avif", quality: 80 }),
    getImage({ src: Wave3, format: "avif", quality: 80 }),
    getImage({ src: Wave4, format: "avif", quality: 80 }),
  ]);
---

<style>
.wave-layer {
  background-repeat: repeat-x;
  background-size: auto 100%;
}

#wave-container {
  --wave-width: 30rem;
  --scene-left: calc((100vw - var(--wave-width)) / 2);
}

#date-wave,
#location-wave {
  display: none;
}

#wave-layer-4 {
  --wave-4-tile-origin: calc(var(--scene-left) + var(--wave-width) * 0.0440667);

  height: calc(var(--wave-width) * 0.353516);
  background-position: var(--wave-4-tile-origin) 0;
}

#date-wave {
  position: absolute;
  top: 0;
  left: var(--wave-4-tile-origin);
  width: auto;
  height: 100%;
}

#wave-layer-3 {
  --wave-3-tile-origin: calc(var(--scene-left) + var(--wave-width) * 0.3348267);

  height: calc(var(--wave-width) * 0.456055);
  margin-top: calc(var(--wave-width) * -0.29);
  background-position: var(--wave-3-tile-origin) 0;
}

#location-wave {
  position: absolute;
  top: 0;
  left: var(--wave-3-tile-origin);
  width: auto;
  height: 100%;
}

#wave-layer-2 {
  height: calc(var(--wave-width) * 0.490234);
  margin-top: calc(var(--wave-width) * -0.35);
  background-position: calc(var(--scene-left) + var(--wave-width) * 0.7027749) 0;
}

#wave-layer-1 {
  height: calc(var(--wave-width) * 0.833984);
  margin-top: calc(var(--wave-width) * -0.4);
  background-position: calc(var(--scene-left) + var(--wave-width) * 0.0424084) 0;
}

@media (min-width: 64rem) {
  #wave-container {
    --wave-width: var(--landing-width);
  }

  #date-wave,
  #location-wave {
    display: block;
  }
}
</style>

<div class="relative w-full" id="wave-container">
  <div
    id="wave-layer-4"
    class="relative z-20 w-full wave-layer"
    style={`background-image: url('${OptimizedWave4.src}');`}
  >
    <Image
      id="date-wave"
      src={DateWave}
      format="avif"
      quality={80}
      alt=""
      aria-hidden="true"
      width={1086}
      sizes="(min-width: 96rem) 67.875rem, 70.625vw"
    />
    <h2 class="sr-only">Date: October 24–25, 2026</h2>
  </div>

  <div
    id="wave-layer-3"
    class="relative z-20 w-full wave-layer"
    style={`background-image: url('${OptimizedWave3.src}');`}
  >
    <Image
      id="location-wave"
      src={LocationWave}
      format="avif"
      quality={80}
      alt=""
      aria-hidden="true"
      width={1215}
      sizes="(min-width: 96rem) 75.9375rem, 79.075vw"
    />
    <h2 class="sr-only">Location: Texas A&M University</h2>
  </div>

  <div
    id="wave-layer-2"
    class="relative z-40 w-full wave-layer"
    style={`background-image: url('${OptimizedWave2.src}');`}
  ></div>

  <div
    id="wave-layer-1"
    class="relative z-40 w-full wave-layer"
    style={`background-image: url('${OptimizedWave1.src}');`}
  ></div>
</div>

<script>
import { gsap } from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";
import { MEDIA } from "../../media";

gsap.registerPlugin(ScrollTrigger);

const layers = [
  { id: "#wave-layer-4", yPercent: -20 },
  { id: "#wave-layer-3", yPercent: -30 },
  { id: "#wave-layer-2", yPercent: -40 },
  { id: "#wave-layer-1", yPercent: -41 },
];

gsap.matchMedia().add(MEDIA.motionSafe, () => {
  const timeline = gsap.timeline({
    scrollTrigger: {
      trigger: "#inner-assets",
      start: "52% top",
      end: "115% top",
      scrub: 0.1,
    },
  });

  layers.forEach(({ id, yPercent }) => {
    timeline.to(id, { duration: 1, ease: "none", yPercent }, 0);
  });

  return () => {
    timeline.scrollTrigger?.kill();
    timeline.kill();
    gsap.set(
      layers.map(({ id }) => id),
      { clearProps: "transform" },
    );
  };
});
</script>

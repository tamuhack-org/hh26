---
import { getImage } from "astro:assets";
import Wave1 from "@assets/landing/wave-1.png";
import Wave2 from "@assets/landing/wave-2.png";
import Wave3 from "@assets/landing/wave-3.png";
import Wave4 from "@assets/landing/wave-4.png";

const [OptimizedWave1, OptimizedWave2, OptimizedWave3, OptimizedWave4] =
  await Promise.all([
    getImage({ src: Wave1, format: "avif", quality: 80 }),
    getImage({ src: Wave2, format: "avif", quality: 80 }),
    getImage({ src: Wave3, format: "avif", quality: 80 }),
    getImage({ src: Wave4, format: "avif", quality: 80 }),
  ]);
---

<style>
.wave-layer {
  background-repeat: repeat-x;
  background-size: auto 100%;
}

#layer-1 {
  height: calc(var(--landing-width) * 0.353516);
}

#layer-2 {
  height: calc(var(--landing-width) * 0.456055);
  margin-top: calc(var(--landing-width) * -0.29);
}

#layer-3 {
  height: calc(var(--landing-width) * 0.490234);
  margin-top: calc(var(--landing-width) * -0.35);
}

#layer-4 {
  height: calc(var(--landing-width) * 0.833984);
  margin-top: calc(var(--landing-width) * -0.4);
}
</style>

<div class="relative w-full" id="wave-container">
  <div
    id="layer-1"
    class="relative w-full wave-layer"
    style={`background-image: url('${OptimizedWave4.src}'); background-position: 15%;`}
  ></div>

  <div
    id="layer-2"
    class="relative w-full wave-layer"
    style={`background-image: url('${OptimizedWave3.src}'); background-position: 160%;`}
  ></div>

  <div
    id="layer-3"
    class="relative w-full z-20 wave-layer"
    style={`background-image: url('${OptimizedWave2.src}'); background-position: 314.2899%;`}
  ></div>

  <div
    id="layer-4"
    class="relative w-full z-20 wave-layer"
    style={`background-image: url('${OptimizedWave1.src}'); background-position: 70%;`}
  ></div>
</div>

<script>
import { gsap } from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";
import { MEDIA } from "../../media";

gsap.registerPlugin(ScrollTrigger);

const layers = [
  { id: "#layer-1", yPercent: -20 },
  { id: "#layer-2", yPercent: -30 },
  { id: "#layer-3", yPercent: -40 },
  { id: "#layer-4", yPercent: -41 },
];

gsap.matchMedia().add(MEDIA.motionSafe, () => {
  const animations = layers.map(({ id, yPercent }) =>
    gsap.to(id, {
      yPercent,
      ease: "none",
      scrollTrigger: {
        trigger: "#inner-assets",
        start: "52% top",
        end: "115% top",
        scrub: 0.1,
      },
    }),
  );

  return () => {
    animations.forEach((animation) => {
      animation.kill();
    });
  };
});
</script>

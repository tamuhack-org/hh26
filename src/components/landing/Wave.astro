---
import { getImage } from "astro:assets";
import Wave1 from "@assets/landing/wave-1.png";
import Wave2 from "@assets/landing/wave-2.png";
import Wave3 from "@assets/landing/wave-3.png";
import Wave4 from "@assets/landing/wave-4.png";

const [OptimizedWave1, OptimizedWave2, OptimizedWave3, OptimizedWave4] =
  await Promise.all([
    getImage({ src: Wave1, format: "avif", quality: 80 }),
    getImage({ src: Wave2, format: "avif", quality: 80 }),
    getImage({ src: Wave3, format: "avif", quality: 80 }),
    getImage({ src: Wave4, format: "avif", quality: 80 }),
  ]);
---

<style>
#wave-container {
  background-repeat: repeat-x;
}
</style>

<div class="relative w-full" id="wave-container">
  <div
    id="layer-1"
    class="relative w-full aspect-1024/362"
    style={`background-image: url('${OptimizedWave4.src}'); background-repeat: repeat-x; background-position: 15%; background-size: auto 100%;`}
  ></div>

  <div
    id="layer-2"
    class="relative mt-[-29%] w-full aspect-1024/467"
    style={`background-image: url('${OptimizedWave3.src}'); background-repeat: repeat-x; background-position: 160%; background-size: auto 100%;`}
  ></div>

  <div
    id="layer-3"
    class="relative mt-[-35%] w-full aspect-1024/502 z-20"
    style={`background-image: url('${OptimizedWave2.src}'); background-repeat: repeat-x; background-position: -15%; background-size: auto 100%;`}
  ></div>

  <div
    id="layer-4"
    class="relative mt-[-40%] w-full aspect-1024/854 z-20"
    style={`background-image: url('${OptimizedWave1.src}'); background-repeat: repeat-x; background-position: 70%; background-size: auto 100%;`}
  ></div>
</div>

<script>
import { gsap } from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";

gsap.registerPlugin(ScrollTrigger);

const layers = [
  { id: "#layer-1", yPercent: -20 },
  { id: "#layer-2", yPercent: -30 },
  { id: "#layer-3", yPercent: -40 },
  { id: "#layer-4", yPercent: -41 },
];

gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", () => {
  const animations = layers.map(({ id, yPercent }) =>
    gsap.to(id, {
      yPercent,
      ease: "none",
      scrollTrigger: {
        trigger: "#landing",
        start: "25% top",
        end: "60% top",
        scrub: 0.1,
      },
    }),
  );

  return () => {
    animations.forEach((animation) => {
      animation.kill();
    });
  };
});
</script>

<svg
    xmlns="http://www.w3.org/2000/svg"
    width="1"
    height="1"
    style="position: absolute; left: -9999px; top: -9999px; overflow: hidden;"
    aria-hidden="true"
>
    <defs>
        <filter
            id="clam-open-noise"
            x="-20%"
            y="-20%"
            width="140%"
            height="140%"
            filterUnits="objectBoundingBox"
            color-interpolation-filters="sRGB"
        >
            <feFlood flood-opacity="0" result="BackgroundImageFix" />
            <feBlend
                mode="normal"
                in="SourceGraphic"
                in2="BackgroundImageFix"
                result="shape"
            />

            <feTurbulence
                type="fractalNoise"
                baseFrequency="0.08 0.08"
                numOctaves="3"
                seed="5783"
                result="noise"
            />

            <feFlood
                flood-color="#F1B042"
                flood-opacity="0.65"
                result="grainColor"
            />
            <feComposite
                operator="in"
                in="grainColor"
                in2="noise"
                result="coloredNoise"
            />

            <feComposite
                operator="in"
                in="coloredNoise"
                in2="shape"
                result="maskedGrain"
            />

            <feMerge>
                <feMergeNode in="shape" />
                <feMergeNode in="maskedGrain" />
            </feMerge>
        </filter>
    </defs>
</svg>

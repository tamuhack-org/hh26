---
import { Image } from "astro:assets";
import AggieClosed from "@assets/prizes/clams/aggie_closed.png";
import AggieOpen from "@assets/prizes/clams/aggie_open.png";
import BeachClosed from "@assets/prizes/clams/beach_closed.png";
import BeachOpen from "@assets/prizes/clams/beach_open.png";
import FirstClosed from "@assets/prizes/clams/first_closed.png";
import FirstOpen from "@assets/prizes/clams/first_open.png";
import HardwareClosed from "@assets/prizes/clams/hardware_closed.png";
import HardwareOpen from "@assets/prizes/clams/hardware_open.png";
import SecondClosed from "@assets/prizes/clams/second_closed.png";
import SecondOpen from "@assets/prizes/clams/second_open.png";
import ThirdClosed from "@assets/prizes/clams/third_closed.png";
import ThirdOpen from "@assets/prizes/clams/third_open.png";
import UiuxClosed from "@assets/prizes/clams/uiux_closed.png";
import UiuxOpen from "@assets/prizes/clams/uiux_open.png";
import DeepSeaBg from "@assets/prizes/deepsea_bg.png";
import AggiePrize from "@assets/prizes/open/aggie_prize.png";
import BeachPrize from "@assets/prizes/open/beach_prize.png";
import FirstPrize from "@assets/prizes/open/first_prize.png";
import HardwarePrize from "@assets/prizes/open/hardware_prize.png";
import SecondPrize from "@assets/prizes/open/second_prize.png";
import ThirdPrize from "@assets/prizes/open/third_prize.png";
import UiuxPrize from "@assets/prizes/open/uiux_prize.png";
import PrizesTitle from "@assets/prizes/prizes_title.svg";
import type { ImageMetadata } from "astro";

interface PrizeItem {
    id: string;
    label: string;
    description: string;
    closed: ImageMetadata;
    open: ImageMetadata;
    image: typeof FirstPrize;
    imageBox: [number, number, number, number, number, number]; // prize placement in the original artwork coordinates
    positionClass: string;
    delay: string;
    gridArea?: string;
}

const prizeList: PrizeItem[] = [
    {
        id: "first",
        label: "1st Place Overall",
        description: "Aurzen Roku TV Smart Projector",
        closed: FirstClosed,
        open: FirstOpen,
        image: FirstPrize,
        imageBox: [0, 12, 197, 181, 197, 197],
        positionClass: "-translate-x-6 -translate-y-4 -rotate-3",
        delay: "0s",
    },
    {
        id: "second",
        label: "2nd Place Overall",
        description: "HP Sprocket Portable Photo Printer",
        closed: SecondClosed,
        open: SecondOpen,
        image: SecondPrize,
        imageBox: [12, 24, 165, 172, 194, 204],
        positionClass: "translate-x-8 -translate-y-12 rotate-6",
        delay: "-1.1s",
    },
    {
        id: "third",
        label: "3rd Place Overall",
        description: "Divoom MiniToo Retro PC Speaker",
        closed: ThirdClosed,
        open: ThirdOpen,
        image: ThirdPrize,
        imageBox: [0, 8, 176, 206, 194, 210],
        positionClass: "-translate-x-4 translate-y-4 -rotate-6",
        delay: "-2.3s",
    },
    {
        id: "uiux",
        label: "Best UI/UX",
        description: "Buddha Water Painting Board",
        closed: UiuxClosed,
        open: UiuxOpen,
        image: UiuxPrize,
        imageBox: [12, 28, 162, 159, 194, 197],
        positionClass: "translate-x-4 -translate-y-8 rotate-3",
        delay: "-0.7s",
    },
    {
        id: "aggie",
        label: "Best Aggie Hack",
        description: "Aggie-opoly Set",
        closed: AggieClosed,
        open: AggieOpen,
        image: AggiePrize,
        imageBox: [6, 32, 190, 161, 197, 197],
        positionClass: "-translate-x-10 -translate-y-8 rotate-6",
        delay: "-1.8s",
        gridArea: "col-start-1",
    },
    {
        id: "hardware",
        label: "Best Hardware Hack",
        description: "Soldering Kit",
        closed: HardwareClosed,
        open: HardwareOpen,
        image: HardwarePrize,
        imageBox: [18, 44, 172, 129, 194, 197],
        positionClass: "translate-x-8 -translate-y-16 -rotate-3",
        delay: "-0.4s",
        gridArea: "col-start-1", // Explicitly skips to the next row
    },
    {
        id: "beach",
        label: "Best Beach Hack",
        description: "Sandbox Desk Set and Palm Tree Neon Sign",
        closed: BeachClosed,
        open: BeachOpen,
        image: BeachPrize,
        imageBox: [6, 0, 190, 202, 198, 202],
        positionClass: "-translate-x-2 -translate-y-8 rotate-3",
        delay: "-2.0s",
        gridArea: "col-start-2 row-start-5",
    },
];
---

<section
    id="prizes"
    aria-labelledby="prizes-heading"
    class="relative w-full min-h-screen overflow-x-clip bg-[#161445] pt-16 max-[63.75rem]:pb-40"
>
    <h2 id="prizes-heading" class="sr-only">Prizes</h2>
    <div class="pointer-events-none absolute inset-0 overflow-hidden">
        <Image
            src={DeepSeaBg}
            format="avif"
            widths={[640, 960, 1280, 1600, 1920, 2400, DeepSeaBg.width]}
            sizes="max(100vw, 300vh)"
            alt=""
            aria-hidden="true"
            loading="lazy"
            class="h-full w-full object-cover object-top max-[63.75rem]:translate-y-32"
        />
    </div>
    <div
        class="relative z-20 w-full min-h-full flex flex-col justify-center items-start text-left"
    >
        <div class=" w-full">
            <ul
                id="clam-grid"
                class="grid grid-cols-2 gap-x-4 w-full max-w-[27.5rem] mx-auto pt-8"
            >
                <!-- Title Tile -->
                <li
                    aria-hidden="true"
                    class="col-span-1 flex items-center justify-center"
                >
                    <PrizesTitle
                        aria-hidden="true"
                        class="relative block h-auto w-[155%] shrink-0 max-w-none translate-x-[36%] -translate-y-12 select-none pointer-events-none sm:max-[63.75rem]:left-24 sm:w-[210%] sm:-translate-x-[10%] sm:translate-y-0 lg:-translate-x-28"
                    />
                </li>

                <!-- Prize Tiles -->
                {prizeList.map((prize) => {
                const [x, y, width, height, svgWidth, svgHeight] = prize.imageBox;
                return (
                <li class={`flex justify-center ${prize.positionClass} ${prize.gridArea ?? ''}`}>
                    <span class="sr-only">{prize.label}: {prize.description}</span>
                    <button
                    class="prize-toggle"
                    data-id={prize.id}
                    data-label={prize.label}
                    data-state="closed"
                    aria-label={`Show ${prize.label}`}
                    aria-expanded="false"
                    type="button"
                    style={`--bob-delay: ${prize.delay};`}
                    >
                    <div class="clam-layer clam-closed">
                        <Image
                            src={prize.closed}
                            format="avif"
                            quality={90}
                            widths={[160, 250, 500]}
                            sizes="(min-width: 40rem) 15.625rem, 50vw"
                            alt=""
                            aria-hidden="true"
                            loading="lazy"
                            class="closed-clam-image"
                        />
                    </div>
                    <div class="clam-layer clam-open">
                        <div class="open-art" style={`aspect-ratio: ${svgWidth} / ${svgHeight};`}>
                            <Image
                                src={prize.open}
                                format="avif"
                                quality={90}
                                widths={[160, 250, 500]}
                                sizes="(min-width: 40rem) 15.625rem, 50vw"
                                alt=""
                                aria-hidden="true"
                                loading="lazy"
                                class="open-clam-image"
                            />
                            <Image
                                src={prize.image}
                                format="avif"
                                quality={90}
                                widths={[160, Math.min(250, prize.image.width), prize.image.width]}
                                sizes="(min-width: 40rem) 15.625rem, 50vw"
                                alt=""
                                aria-hidden="true"
                                loading="lazy"
                                class="prize-image"
                                style={`left: ${x / svgWidth * 100}%; top: ${y / svgHeight * 100}%; width: ${width / svgWidth * 100}%; height: ${height / svgHeight * 100}%;`}
                            />
                        </div>
                    </div>
                    </button>
                </li>
                );
                })}
            </ul>
            <style>
            .prize-toggle {
                position: relative;
                top: -2rem;
                display: inline-flex;
                flex-shrink: 0;
                width: 100%;
                max-width: 15.625rem;
                aspect-ratio: 1 / 1;
                height: auto;
                margin: auto;
                background: transparent;
                border: none;
                padding: 0;
                cursor: pointer;
                perspective: 50rem;
                outline: none;
                -webkit-tap-highlight-color: transparent;
                animation: clam-bob 3.2s ease-in-out infinite
                    var(--bob-delay, 0s);
                will-change: transform;
            }

            .prize-toggle:focus-visible {
                outline: 2px solid var(--color-amber-400, #f59e0b);
                outline-offset: 4px;
                border-radius: 9999px;
            }

            .clam-layer {
                width: 100%;
                height: 100%;
                display: flex;
                align-items: center;
                justify-content: center;
                transition:
                    opacity 450ms cubic-bezier(0.34, 1.56, 0.64, 1),
                    transform 450ms cubic-bezier(0.34, 1.56, 0.64, 1);
                transform-origin: bottom center;
                will-change: transform, opacity;
            }

            .closed-clam-image {
                width: 100%;
                height: auto;
                aspect-ratio: 194 / 181;
                object-fit: fill;
                display: block;
            }

            .open-clam-image {
                position: absolute;
                inset: 0;
                width: 100%;
                height: 100%;
                object-fit: fill;
                display: block;
            }

            .clam-open {
                position: absolute;
                inset: 0;
            }

            .open-art {
                position: relative;
                width: 100%;
            }

            .prize-image {
                position: absolute;
                object-fit: fill;
                pointer-events: none;
            }

            /* Closed clam state */
            .prize-toggle[data-state="closed"] .clam-closed {
                opacity: 1;
                transform: scale(1) translateY(0) rotateX(0deg);
                pointer-events: auto;
            }

            .prize-toggle[data-state="closed"] .clam-open {
                opacity: 0;
                transform: scale(0.85) translateY(12px) rotateX(-25deg);
                pointer-events: none;
            }

            /* Open clam state */
            .prize-toggle[data-state="open"] .clam-closed {
                opacity: 0;
                transform: scale(1.08) translateY(-14px) rotateX(25deg);
                pointer-events: none;
            }

            .prize-toggle[data-state="open"] .clam-open {
                opacity: 1;
                transform: scale(1) translateY(0) rotateX(0deg);
                pointer-events: auto;
            }

            /* Active press feedback */
            .prize-toggle:active .clam-layer {
                transition-duration: 100ms;
                transform: scale(0.96);
            }

            @keyframes clam-bob {
                0%,
                100% {
                    transform: translateY(0);
                }
                50% {
                    transform: translateY(-4px);
                }
            }

            .prize-toggle:active {
                animation-play-state: paused;
            }

            @media (prefers-reduced-motion: reduce) {
                .prize-toggle {
                    animation: none;
                    will-change: auto;
                }

                .clam-layer,
                .prize-toggle:active .clam-layer {
                    transition: none;
                    will-change: auto;
                }

                .prize-toggle:active .clam-layer {
                    transform: none;
                }
            }

            @media (width >= 40rem) {
                .prize-toggle {
                    width: 120%;
                }
            }

            @media (width < 63.75rem) {
                .prize-toggle {
                    top: 6rem;
                }
            }
            </style>
            <script>
            const initToggles = () => {
                const grid = document.getElementById("clam-grid");
                if (!grid || grid.dataset.ready) return;
                grid.dataset.ready = "true";

                grid.addEventListener("click", (e) => {
                    const toggle = (
                        e.target as HTMLElement
                    ).closest<HTMLButtonElement>(".prize-toggle");
                    if (!toggle) return;

                    e.stopPropagation();
                    const isClosed =
                        toggle.getAttribute("data-state") === "closed";
                    toggle.setAttribute(
                        "data-state",
                        isClosed ? "open" : "closed",
                    );
                    toggle.setAttribute("aria-expanded", String(isClosed));
                    const prizeLabel = toggle.dataset.label;
                    if (prizeLabel) {
                        toggle.setAttribute(
                            "aria-label",
                            `${isClosed ? "Hide" : "Show"} ${prizeLabel}`,
                        );
                    }
                });
            };

            initToggles();
            document.addEventListener("astro:page-load", initToggles);
            document.addEventListener("astro:after-swap", initToggles);
            </script>
        </div>
    </div>
    <div class="prizes-transition-top" aria-hidden="true"></div>
    <div class="prizes-transition" aria-hidden="true"></div>
</section>

<style>
.prizes-transition-top,
.prizes-transition {
    position: absolute;
    z-index: 10;
    right: 0;
    left: 0;
    pointer-events: none;
}

.prizes-transition-top {
    top: 0;
    height: clamp(12rem, 24vw, 20rem);
    background: linear-gradient(to bottom, #161445 0%, transparent 100%);
}

.prizes-transition {
    bottom: 0;
    height: clamp(5rem, 10vw, 9rem);
    background: linear-gradient(to bottom, transparent, #080621);
}
</style>

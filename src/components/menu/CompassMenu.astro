---
import CompassBlank from "@assets/menu_assets/compass-blank.svg";
import Needle from "@assets/menu_assets/compass-needle.svg";
import MenuText from "@assets/menu_assets/menu.svg";
import About from "@assets/menu_assets/about.svg";
import Faq from "@assets/menu_assets/faq.svg";
import Schedule from "@assets/menu_assets/schedule.svg";
import Prizes from "@assets/menu_assets/prizes.svg";

interface Props {
  variant?: "arc" | "ring";
}

const { variant = "ring" } = Astro.props;
---

<nav class:list={["compass-menu", `compass-menu--${variant}`]} aria-label="Main navigation">
  <div class="labels">
    <a class="label label--about" href="#about"><About /></a>
    <a class="label label--faq" href="#faq"><Faq /></a>
    <a class="label label--schedule" href="#schedule"><Schedule /></a>
    <a class="label label--prizes" href="#prizes"><Prizes /></a>
  </div>

  <div class="compass">
    <MenuText class="menu-text" />
    <CompassBlank class="face" />
    <Needle class="needle" />
  </div>
</nav>

<style>
  .compass-menu {
    position: relative;
    width: 500px;
    height: 300px;
  }

  .compass {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 182px;
    height: 182px;
  }

  .face {
    display: block;
    width: 182px;
    height: 182px;
  }

  .menu-text {
    position: absolute;
    top: -43px;
    left: 48.5px;
  }

  .needle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    transform-origin: center;
    transition: transform 0.9s cubic-bezier(0.34, 1.3, 0.64, 1);
  }

  .label {
    position: absolute;
    display: block;
    opacity: 0;
    transform: translate(var(--tx), var(--ty));
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
  }

  .label--faq {
    transition-delay: 0.08s;
  }
  .label--schedule {
    transition-delay: 0.16s;
  }
  .label--prizes {
    transition-delay: 0.24s;
  }

  .compass-menu--arc .label {
    --tx: 80px;
    --ty: 0px;
  }
  .compass-menu--arc .label--about {
    top: 49px;
    left: 30px;
  }
  .compass-menu--arc .label--faq {
    top: 102px;
    left: 78px;
  }
  .compass-menu--arc .label--schedule {
    top: 150px;
    left: 88px;
  }
  .compass-menu--arc .label--prizes {
    top: 201px;
    left: 30px;
  }

  .compass-menu--ring .label--about {
    top: 21px;
    left: 234px;
    --tx: 48px;
    --ty: 43px;
  }
  .compass-menu--ring .label--faq {
    top: 62px;
    left: 236px;
    --tx: 54px;
    --ty: 25px;
  }
  .compass-menu--ring .label--schedule {
    top: 205px;
    left: 165px;
    --tx: 67px;
    --ty: -31px;
  }
  .compass-menu--ring .label--prizes {
    top: 251px;
    left: 262px;
    --tx: 35px;
    --ty: -50px;
  }

  .compass-menu:hover .needle {
    transform: translate(-50%, -50%) rotate(540deg);
  }

  .compass-menu:hover .label {
    opacity: 1;
    transform: translate(0, 0);
  }
</style>

---
import { Image } from "astro:assets";
import Wave1 from "../assets/wave-1-front-single.png"
import Wave2 from "../assets/wave-2-single.png"
import Wave3 from "../assets/wave-3-single.png"
import Wave4 from "../assets/wave-4-back-single.png"
import BackG from '../assets/background.png'
---

<body style={`background-image: url('${BackG.src}'); background-size: cover; background-repeat: no-repeat; overflow-x:hidden`}>
    <div class="h-full">

    </div>
    <div class="w-full h-100">
        <section class="relative w-full h-screen overflow-visible" id="layers">
            <Image src={Wave4} alt={''} id={'layer-1'} class="absolute top-55 right-20 w-full"/>
            <Image src={Wave3} alt={''} id={'layer-2'} class="absolute top-70 left-16 w-full"/>
            <Image src={Wave2} alt={''} id={'layer-3'} class="absolute top-75 right-20 w-full"/>
            <Image src={Wave1} alt={''} id={'layer-4'} class="absolute top-90 w-full"/>
        </section>
    </div>
    <div class="h-full">

    </div>
    <div class="h-full">

    </div>

</body>



<script>
    import { gsap } from "gsap";
    import { MotionPathHelper } from "gsap/MotionPathHelper";
    import { MotionPathPlugin } from "gsap/MotionPathPlugin";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(MotionPathHelper,MotionPathPlugin,ScrollTrigger);

    const tl = gsap.timeline({
        scrollTrigger:{
            trigger:"#fish",
            start:"top 60%",
            end:"+=500",
            scrub:1,
            markers:true,
        }
    })

    const layers = [
    { id: "#layer-1", yPercent: 0 },
    { id: "#layer-2", yPercent: 0 },
    { id: "#layer-3", yPercent: 0 },
    { id: "#layer-4", yPercent: 0 },
    ];

    layers.forEach(({ id, yPercent }) => {
    gsap.to(id, {
        yPercent,
        ease: "none",
        scrollTrigger: {
        trigger: "#layers",
        start: "top top",
        end: "bottom top",
        scrub: 1,
        },
    });
    });

    tl.to("#fish", {
        ease: "none",
        motionPath: {
            path:"M59.103,89.141 C66.103,70.141 300.433,-94.741 363.601,-131.358 424.575,-166.703 618.35,-258.245 656.487,-255.68 707.771,-252.23 1250.578,-7.716 1200.788,24.56 1316.644,110.424 709.573,216.425 679.325,258.735",
            autoRotate: true,
            alignOrigin: [0.5, 0.5],
        },
        keyframes: [
            { scale: 2, duration: 0 },
            { scale: 1.1, duration: 0.4 },
            { scale: 0.5, duration: 0.6 },
        ]
    })

    // MotionPathHelper.create("#fish")
</script>
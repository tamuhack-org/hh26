<style>
.stage {
  width: 720px;
  height: 493px;
  max-width: 90vw;
  max-height: 90vh;
}
svg {
  width: 100%;
  height: 100%;
  display: block;
  overflow: visible;
}
.jelly {
  fill: white;
}
</style>

<script>
(() => {
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;

  const DEFAULTS = {
    samples: 200,
    radius: 156,
    strength: 6.4,
    spring: 0.44,
    damping: 0.78,
    smoothing: 0.2,
    sleepThreshold: 0.02,
    minForceDist: 8, // distance floor: no force spike up close
    minSubpathPoints: 3, // keep tiny subpaths (holes)
  };

  const controllers = [];
  const svgStates = new Map();

  function getSvgState(svg) {
    let s = svgStates.get(svg);
    if (s) return s;

    s = { svg, mouse: null, hovering: false, visible: true, ctmInv: null };
    svgStates.set(svg, s);

    const refreshCTM = () => {
      const m = svg.getScreenCTM();
      s.ctmInv = m ? m.inverse() : null;
    };

    svg.addEventListener("pointerenter", () => {
      s.hovering = true;
      refreshCTM();
      ensureRunning();
    });
    svg.addEventListener("pointermove", (e) => {
      if (!s.ctmInv) refreshCTM();
      if (s.ctmInv) {
        const pt = svg.createSVGPoint();
        pt.x = e.clientX;
        pt.y = e.clientY;
        const local = pt.matrixTransform(s.ctmInv);
        s.mouse = { x: local.x, y: local.y };
      }
      s.hovering = true;
      ensureRunning();
    });
    svg.addEventListener("pointerleave", () => {
      s.hovering = false;
    });

    // matrix only shifts on layout, not per move
    window.addEventListener("scroll", refreshCTM, { passive: true });
    window.addEventListener("resize", refreshCTM);

    if ("IntersectionObserver" in window) {
      new IntersectionObserver(([entry]) => {
        s.visible = entry.isIntersecting;
        if (s.visible) {
          refreshCTM();
          ensureRunning();
        }
      }).observe(svg);
    }
    return s;
  }

  // ---- Sample path into closed point loops ----
  function jellyfy(pathEl, options = {}) {
    const opt = Object.assign({}, DEFAULTS, options);
    const svg = pathEl.ownerSVGElement;
    if (!svg) return;
    const state = getSvgState(svg);

    const totalLength = pathEl.getTotalLength();
    if (!totalLength) return;
    const stepLen = totalLength / opt.samples;

    const raw = [];
    for (let i = 0; i < opt.samples; i++) {
      const p = pathEl.getPointAtLength(i * stepLen);
      raw.push({ x: p.x, y: p.y });
    }

    const N = raw.length;
    const gapThreshold = Math.max(stepLen * 3, 2);
    const gaps = [];
    for (let i = 0; i < N; i++) {
      const cur = raw[i];
      const prev = raw[(i - 1 + N) % N];
      if (Math.hypot(cur.x - prev.x, cur.y - prev.y) > gapThreshold)
        gaps.push(i);
    }

    const groups = [];
    if (gaps.length === 0) {
      groups.push(raw);
    } else {
      for (let g = 0; g < gaps.length; g++) {
        const start = gaps[g];
        const end = gaps[(g + 1) % gaps.length];
        const sp = [];
        for (let i = start; i !== end; i = (i + 1) % N) sp.push(raw[i]);
        groups.push(sp);
      }
    }

    const subs = groups
      .filter((sp) => sp.length >= opt.minSubpathPoints)
      .map((sp) =>
        sp.map((p) => ({ rx: p.x, ry: p.y, x: p.x, y: p.y, vx: 0, vy: 0 })),
      );
    if (!subs.length) return;

    // rest-shape bbox: skip paths far from the cursor
    let minX = Infinity,
      minY = Infinity,
      maxX = -Infinity,
      maxY = -Infinity;
    for (const sp of subs)
      for (const p of sp) {
        if (p.rx < minX) minX = p.rx;
        if (p.rx > maxX) maxX = p.rx;
        if (p.ry < minY) minY = p.ry;
        if (p.ry > maxY) maxY = p.ry;
      }

    controllers.push({
      pathEl,
      state,
      opt,
      subs,
      awake: false,
      bbox: { minX, minY, maxX, maxY },
    });
  }

  // ---- Physics: one settling step ----
  function stepController(c, sub, steps, mouse) {
    const { spring, damping, smoothing, strength, radius, minForceDist } =
      c.opt;
    const radiusSq = radius * radius;
    const dampSub = damping ** sub;
    let maxMotion = 0;
    let mouseActive = false;

    for (let s = 0; s < steps; s++) {
      const lastStep = s === steps - 1;
      for (const sp of c.subs) {
        const n = sp.length;
        for (let i = 0; i < n; i++) {
          const p = sp[i];
          const pl = sp[(i - 1 + n) % n];
          const pr = sp[(i + 1) % n];

          // pull back toward rest shape
          p.vx += (p.rx - p.x) * spring * sub;
          p.vy += (p.ry - p.y) * spring * sub;

          // couple neighbour displacement (zero at rest, so nothing shrinks)
          const myDx = p.x - p.rx,
            myDy = p.y - p.ry;
          const avgDx = (pl.x - pl.rx + (pr.x - pr.rx)) * 0.5;
          const avgDy = (pl.y - pl.ry + (pr.y - pr.ry)) * 0.5;
          p.vx += (avgDx - myDx) * smoothing * sub;
          p.vy += (avgDy - myDy) * smoothing * sub;

          if (mouse) {
            const mdx = p.x - mouse.x;
            const mdy = p.y - mouse.y;
            const distSq = mdx * mdx + mdy * mdy;
            if (distSq < radiusSq && distSq > 0.0001) {
              mouseActive = true;
              const dist = Math.sqrt(distSq);
              const t = dist / radius;
              const falloff = 1 - t * t * (3 - 2 * t); // smoothstep edge
              const force = (falloff * strength) / Math.max(dist, minForceDist);
              p.vx += mdx * force * sub;
              p.vy += mdy * force * sub;
            }
          }

          p.vx *= dampSub;
          p.vy *= dampSub;
          p.x += p.vx * sub;
          p.y += p.vy * sub;

          if (lastStep) {
            const m =
              Math.abs(p.vx) +
              Math.abs(p.vy) +
              Math.abs(p.x - p.rx) +
              Math.abs(p.y - p.ry);
            if (m > maxMotion) maxMotion = m;
          }
        }
      }
    }
    return { maxMotion, mouseActive };
  }

  // ---- Rebuild path as Catmull-Rom spline ----
  const ALPHA = 0.5; // 0 = uniform, 0.5 = centripetal
  const EPS = 1e-4;
  function buildPath(subs) {
    let d = "";
    for (const sp of subs) {
      const n = sp.length;
      d += `M${sp[0].x.toFixed(2)} ${sp[0].y.toFixed(2)}`;
      for (let i = 0; i < n; i++) {
        const p0 = sp[(i - 1 + n) % n];
        const p1 = sp[i];
        const p2 = sp[(i + 1) % n];
        const p3 = sp[(i + 2) % n];

        // knot spacing weighted by chord^alpha
        const d01 = Math.max(
          Math.hypot(p1.x - p0.x, p1.y - p0.y) ** ALPHA,
          EPS,
        );
        const d12 = Math.max(
          Math.hypot(p2.x - p1.x, p2.y - p1.y) ** ALPHA,
          EPS,
        );
        const d23 = Math.max(
          Math.hypot(p3.x - p2.x, p3.y - p2.y) ** ALPHA,
          EPS,
        );

        const t2 = d01 + d12;
        const t31 = d12 + d23;

        // non-uniform Catmull-Rom tangents -> Bezier handles
        const m1x =
          d12 *
          ((p1.x - p0.x) / d01 - (p2.x - p0.x) / t2 + (p2.x - p1.x) / d12);
        const m1y =
          d12 *
          ((p1.y - p0.y) / d01 - (p2.y - p0.y) / t2 + (p2.y - p1.y) / d12);
        const m2x =
          d12 *
          ((p2.x - p1.x) / d12 - (p3.x - p1.x) / t31 + (p3.x - p2.x) / d23);
        const m2y =
          d12 *
          ((p2.y - p1.y) / d12 - (p3.y - p1.y) / t31 + (p3.y - p2.y) / d23);

        const cp1x = p1.x + m1x / 3,
          cp1y = p1.y + m1y / 3;
        const cp2x = p2.x - m2x / 3,
          cp2y = p2.y - m2y / 3;

        d +=
          "C" +
          cp1x.toFixed(2) +
          " " +
          cp1y.toFixed(2) +
          " " +
          cp2x.toFixed(2) +
          " " +
          cp2y.toFixed(2) +
          " " +
          p2.x.toFixed(2) +
          " " +
          p2.y.toFixed(2);
      }
      d += "Z";
    }
    return d;
  }

  // ---- Shared animation loop ----
  let loopRunning = false;
  let lastT = 0;

  function ensureRunning() {
    if (loopRunning) return;
    loopRunning = true;
    lastT = performance.now() - 1000 / 60;
    requestAnimationFrame(tick);
  }

  function tick(now) {
    // frame-time in 60fps units; clamp + sub-step so a stall can't blow up
    let dt = (now - lastT) / (1000 / 60);
    lastT = now;
    if (!(dt > 0)) dt = 1;
    dt = Math.min(dt, 4);
    const steps = Math.max(1, Math.ceil(dt));
    const sub = dt / steps;

    let anyAwake = false;

    for (const c of controllers) {
      const st = c.state;
      if (!st.visible) {
        c.awake = false;
        continue;
      }

      const mouse = st.hovering ? st.mouse : null;
      if (!c.awake && !mouse) continue;

      const { maxMotion, mouseActive } = stepController(c, sub, steps, mouse);
      c.pathEl.setAttribute("d", buildPath(c.subs));

      c.awake = mouseActive || maxMotion >= c.opt.sleepThreshold;
      if (c.awake) anyAwake = true;
    }

    if (anyAwake) requestAnimationFrame(tick);
    else loopRunning = false;
  }

  // ---- Init ----
  document.querySelectorAll(".jelly").forEach((el) => {
    jellyfy(el, {
      samples: 200,
      radius: 156,
      strength: 6.4,
      spring: 0.44,
      damping: 0.78,
      smoothing: 0.2,
    });
  });
})();
</script>

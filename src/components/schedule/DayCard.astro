---
interface Props {
    title: string;
    weekday: string;
    texture: string;
    borderFrom: string;
    borderTo: string;
    borderStart: string;
    borderEnd: string;
    locationWeight: number;
}

const {
    title,
    weekday,
    texture,
    borderFrom,
    borderTo,
    borderStart,
    borderEnd,
    locationWeight,
} = Astro.props;
---

<article
    class="schedule-day"
    data-weekday={weekday}
    style={`--day-border-from: ${borderFrom}; --day-border-to: ${borderTo}; --day-border-start: ${borderStart}; --day-border-end: ${borderEnd}; --day-location-weight: ${locationWeight}; --day-texture: url("${texture}")`}
>
    <div class="schedule-day-inner">
        <h3 class="schedule-day-title">{title}</h3>
        <ul class="schedule-day-events"></ul>
    </div>
</article>

<style>
.schedule-day {
    --day-glow-size: 20rem;
    --day-glow-x: -100rem;
    --day-glow-y: -100rem;

    display: flex;
    flex: 1 1 0;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    padding-top: 1rem;
    overflow: hidden;
    border: 0.5rem solid transparent;
    border-radius: 2.0625rem;
    background-image:
        linear-gradient(#080625, #080625),
        linear-gradient(
            180deg,
            var(--day-border-from) var(--day-border-start),
            var(--day-border-to) var(--day-border-end)
        );
    background-origin: padding-box, border-box;
    background-clip: padding-box, border-box;
    box-shadow: inset 0 4px 4px rgb(0 0 0 / 0.25);
}

.schedule-day[data-glow] {
    background-image:
        linear-gradient(#080625, #080625),
        radial-gradient(
            circle var(--day-glow-size) at var(--day-glow-x) var(--day-glow-y),
            var(--day-border-to) 0%,
            transparent 100%
        ),
        linear-gradient(var(--day-border-from), var(--day-border-from));
    background-origin: padding-box, border-box, border-box;
    background-clip: padding-box, border-box, border-box;
}

.schedule-day-inner {
    position: relative;
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem;
    background-image: var(--day-texture);
    background-position: 0 0;
    background-repeat: no-repeat;
    background-size: 100% 100%;
}

.schedule-day-title {
    font-family: var(--font-poppins);
    font-size: 2.25rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.02em;
    text-shadow: 0 4px 4px rgb(0 0 0 / 0.25);
}

.schedule-day-events {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
    padding: 0.625rem 1rem;
    list-style: none;
}

.schedule-entry {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    font-family: var(--font-poppins);
    font-size: 1rem;
    color: #ffffff;
    letter-spacing: 0.02em;
}

.schedule-entry-time {
    flex-shrink: 0;
    font-weight: 600;
    white-space: nowrap;
}

.schedule-entry-detail {
    display: flex;
    flex: 1 1 0;
    min-width: 0;
    flex-direction: column;
    gap: 0.5rem;
    text-align: right;
}

.schedule-entry-name {
    font-weight: 600;
}

.schedule-entry-location {
    font-weight: var(--day-location-weight);
    opacity: 75%;
}

@media (width < 64rem) {
    .schedule-day {
        flex: 0 0 auto;
    }

    .schedule-day-title {
        font-size: 1rem;
    }

    .schedule-entry {
        align-items: center;
    }

    .schedule-entry-time {
        font-weight: 800;
    }

    .schedule-entry-name {
        font-weight: 700;
    }

    .schedule-entry-location {
        font-weight: 300;
    }
}
</style>

<script>
import { MEDIA } from "../../media";

const cards = document.querySelectorAll<HTMLElement>(
    ".schedule-day[data-weekday]",
);

const fineHover = window.matchMedia(MEDIA.fineHover);
const motionSafe = window.matchMedia(MEDIA.motionSafe);

function moveGlow(event: PointerEvent) {
    for (const card of cards) {
        const rect = card.getBoundingClientRect();
        card.style.setProperty(
            "--day-glow-x",
            `${event.clientX - rect.left}px`,
        );
        card.style.setProperty("--day-glow-y", `${event.clientY - rect.top}px`);
    }
}

if (fineHover.matches && motionSafe.matches) {
    for (const card of cards) {
        card.dataset.glow = "";
    }
    document.addEventListener("pointermove", moveGlow);
}
</script>

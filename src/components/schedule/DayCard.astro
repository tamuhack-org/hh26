---
interface Props {
    title: string;
    weekday: string;
    texture: string;
    borderFrom: string;
    borderTo: string;
    borderStart: string;
    borderEnd: string;
    locationWeight: number;
}

const {
    title,
    weekday,
    texture,
    borderFrom,
    borderTo,
    borderStart,
    borderEnd,
    locationWeight,
} = Astro.props;
---

<article
    class="schedule-day"
    data-weekday={weekday}
    style={`--day-border-from: ${borderFrom}; --day-border-to: ${borderTo}; --day-border-start: ${borderStart}; --day-border-end: ${borderEnd}; --day-location-weight: ${locationWeight}; --day-texture: url("${texture}")`}
>
    <div class="schedule-day-inner">
        <h3 class="schedule-day-title">{title}</h3>
        <ul class="schedule-day-events"></ul>
    </div>
</article>

<style>
.schedule-day {
    --day-glow-size: 20rem;
    --day-glow-x: -100rem;
    --day-glow-y: -100rem;

    display: flex;
    flex: 1 1 0;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    padding-top: 1rem;
    overflow: hidden;
    border: 0.5rem solid transparent;
    border-radius: 2.0625rem;
    background-image:
        linear-gradient(#080625, #080625),
        linear-gradient(
            180deg,
            var(--day-border-from) var(--day-border-start),
            var(--day-border-to) var(--day-border-end)
        );
    background-origin: padding-box, border-box;
    background-clip: padding-box, border-box;
    box-shadow: inset 0 4px 4px rgb(0 0 0 / 0.25);
}

.schedule-day[data-glow] {
    background-image:
        linear-gradient(#080625, #080625),
        radial-gradient(
            circle var(--day-glow-size) at var(--day-glow-x) var(--day-glow-y),
            var(--day-border-to) 0%,
            transparent 100%
        ),
        linear-gradient(var(--day-border-from), var(--day-border-from));
    background-origin: padding-box, border-box, border-box;
    background-clip: padding-box, border-box, border-box;
}

.schedule-day-inner {
    position: relative;
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem;
    background-image: var(--day-texture);
    background-position: 0 0;
    background-repeat: no-repeat;
    background-size: 100% 100%;
}

.schedule-day-title {
    font-family: var(--font-poppins);
    font-size: 2.25rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.02em;
    text-shadow: 0 4px 4px rgb(0 0 0 / 0.25);
}

.schedule-day-events {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
    padding: 0.625rem 1rem;
    list-style: none;
}

.schedule-entry {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: 1rem;
    row-gap: 0.5rem;
    font-family: var(--font-poppins);
    font-size: 1rem;
    color: #ffffff;
    letter-spacing: 0.02em;
}

.schedule-entry-time {
    grid-column: 1;
    grid-row: 1;
    align-self: start;
    font-weight: 600;
    white-space: nowrap;
}

.schedule-entry-name {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
    text-align: right;
    font-weight: 600;
}

.schedule-entry-location {
    grid-column: 2;
    grid-row: 2;
    min-width: 0;
    text-align: right;
    font-weight: var(--day-location-weight);
    opacity: 75%;
}

@media (width < 64rem) {
    .schedule-day {
        flex: 0 0 auto;
    }

    .schedule-day-title {
        font-size: 1rem;
    }

    .schedule-entry-time {
        align-self: center;
        font-weight: 800;
    }

    .schedule-entry-name {
        font-weight: 700;
    }

    .schedule-entry-location {
        font-weight: 300;
    }
}
</style>

<script>
import { MEDIA } from "../../media";

const cards = document.querySelectorAll<HTMLElement>(
    ".schedule-day[data-weekday]",
);

const fineHover = window.matchMedia(MEDIA.fineHover);
let frame = 0;
let pointerX = 0;
let pointerY = 0;
const activeCards = new Set<HTMLElement>();

function updateGlow() {
    frame = 0;
    const rootFontSize = parseFloat(
        getComputedStyle(document.documentElement).fontSize,
    );

    for (const card of cards) {
        const rect = card.getBoundingClientRect();
        const glowSize =
            getComputedStyle(card).getPropertyValue("--day-glow-size");
        const glowRadius = parseFloat(glowSize) * rootFontSize;
        const distanceX = Math.max(
            rect.left - pointerX,
            0,
            pointerX - rect.right,
        );
        const distanceY = Math.max(
            rect.top - pointerY,
            0,
            pointerY - rect.bottom,
        );
        const inReach = Math.hypot(distanceX, distanceY) <= glowRadius;

        if (inReach) {
            card.style.setProperty("--day-glow-x", `${pointerX - rect.left}px`);
            card.style.setProperty("--day-glow-y", `${pointerY - rect.top}px`);
            activeCards.add(card);
        } else if (activeCards.delete(card)) {
            card.style.removeProperty("--day-glow-x");
            card.style.removeProperty("--day-glow-y");
        }
    }
}

function moveGlow(event: PointerEvent) {
    pointerX = event.clientX;
    pointerY = event.clientY;
    if (!frame) frame = requestAnimationFrame(updateGlow);
}

function syncGlowMode() {
    if (fineHover.matches) {
        for (const card of cards) card.dataset.glow = "";
        document.addEventListener("pointermove", moveGlow);
    } else {
        document.removeEventListener("pointermove", moveGlow);
        cancelAnimationFrame(frame);
        frame = 0;
        for (const card of activeCards) {
            card.style.removeProperty("--day-glow-x");
            card.style.removeProperty("--day-glow-y");
        }
        activeCards.clear();
        for (const card of cards) delete card.dataset.glow;
    }
}

syncGlowMode();
fineHover.addEventListener("change", syncGlowMode);
</script>

---
import type { ScheduleEvent } from "./Days.astro";

interface Props {
    title: string;
    events: ScheduleEvent[];
    texture: string;
    borderFrom: string;
    borderTo: string;
    borderStart: string;
    borderEnd: string;
    locationWeight: number;
}

const {
    title,
    events,
    texture,
    borderFrom,
    borderTo,
    borderStart,
    borderEnd,
    locationWeight,
} = Astro.props;

const timeFormatter = new Intl.DateTimeFormat("en-US", {
    timeZone: "America/Chicago",
    hour: "2-digit",
    minute: "2-digit",
    hour12: true,
});
---

<article
    class="schedule-day"
    style={`--day-border-from: ${borderFrom}; --day-border-to: ${borderTo}; --day-border-start: ${borderStart}; --day-border-end: ${borderEnd}; --day-location-weight: ${locationWeight}; --day-texture: url("${texture}")`}
>
    <div class="schedule-day-inner">
        <h3 class="schedule-day-title">{title}</h3>
        <ul class="schedule-day-events">
            {events.map((event) => (
                <li class="schedule-entry">
                    <span class="schedule-entry-time">
                        {timeFormatter.format(new Date(event.date))}
                    </span>
                    <span class="schedule-entry-detail">
                        <span class="schedule-entry-name">
                            {event.eventName}
                        </span>
                        {event.location && (
                            <span class="schedule-entry-location">
                                {event.location}
                            </span>
                        )}
                    </span>
                </li>
            ))}
        </ul>
    </div>
</article>

<style>
@property --day-glow-opacity {
    syntax: "<number>";
    inherits: false;
    initial-value: 0;
}

.schedule-day {
    --day-glow-size: 4.25rem;
    --day-glow-x: 50%;
    --day-glow-y: 50%;
    --day-glow-color: color-mix(in srgb, var(--day-border-to), #ffffff 35%);

    display: flex;
    flex: 1 1 0;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    padding-top: 1rem;
    overflow: hidden;
    border: 0.5rem solid transparent;
    border-radius: 2.0625rem;
    background-image:
        linear-gradient(#080625, #080625),
        radial-gradient(
            circle var(--day-glow-size) at var(--day-glow-x) var(--day-glow-y),
            color-mix(
                    in srgb,
                    var(--day-glow-color) calc(var(--day-glow-opacity) * 100%),
                    transparent
                )
                0%,
            transparent 100%
        ),
        linear-gradient(
            180deg,
            var(--day-border-from) var(--day-border-start),
            var(--day-border-to) var(--day-border-end)
        );
    background-origin: padding-box, border-box, border-box;
    background-clip: padding-box, border-box, border-box;
    box-shadow: inset 0 4px 4px rgb(0 0 0 / 0.25);
    transition: --day-glow-opacity 220ms ease;
}

@media (prefers-reduced-motion: reduce) {
    .schedule-day {
        transition: none;
    }
}

.schedule-day-inner {
    position: relative;
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem;
    background-image: var(--day-texture);
    background-position: 0 0;
    background-repeat: no-repeat;
    background-size: 100% 100%;
}

.schedule-day-title {
    font-family: var(--font-poppins);
    font-size: 2.25rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.02em;
    text-shadow: 0 4px 4px rgb(0 0 0 / 0.25);
}

.schedule-day-events {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
    padding: 0.625rem 1rem;
    list-style: none;
}

.schedule-entry {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    font-family: var(--font-poppins);
    font-size: 1rem;
    color: #ffffff;
    letter-spacing: 0.02em;
}

.schedule-entry-time {
    flex-shrink: 0;
    font-weight: 600;
    white-space: nowrap;
}

.schedule-entry-detail {
    display: flex;
    flex: 1 1 0;
    min-width: 0;
    flex-direction: column;
    gap: 0.5rem;
    text-align: right;
}

.schedule-entry-name {
    font-weight: 600;
}

.schedule-entry-location {
    font-weight: var(--day-location-weight);
}

@media (width < 64rem) {
    .schedule-day {
        flex: 0 0 auto;
    }

    .schedule-day-title {
        font-size: 1rem;
    }

    .schedule-entry {
        align-items: center;
    }

    .schedule-entry-time {
        font-weight: 800;
    }

    .schedule-entry-name {
        font-weight: 700;
    }

    .schedule-entry-location {
        font-weight: 300;
    }
}
</style>

<script>
import { MEDIA } from "../../media";

const fineHover = window.matchMedia(MEDIA.fineHover);

function track(card: HTMLElement) {
    card.addEventListener("pointermove", (event) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty(
            "--day-glow-x",
            `${event.clientX - rect.left}px`,
        );
        card.style.setProperty("--day-glow-y", `${event.clientY - rect.top}px`);
    });
    card.addEventListener("pointerenter", () => {
        card.style.setProperty("--day-glow-opacity", "1");
    });
    card.addEventListener("pointerleave", () => {
        card.style.setProperty("--day-glow-opacity", "0");
    });
}

if (fineHover.matches) {
    for (const card of document.querySelectorAll<HTMLElement>(
        ".schedule-day",
    )) {
        track(card);
    }
}
</script>

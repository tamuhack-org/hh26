---
import { Picture } from "astro:assets";
import Submarine from "@assets/schedule/submarine.png";
---

<style>
.submarine {
    margin-left: 32.8125rem;
    margin-top: 29.3125rem;
    width: 26.9183rem;
}

.submarine-img {
    display: block;
    width: 100%;
    height: auto;
}

@media (width < 64rem) {
    .submarine {
        margin-left: 5.0552rem;
        margin-top: 2.9375rem;
        width: 15.8271rem;
    }
}
</style>

<div aria-hidden="true" class="submarine pointer-events-none z-15">
    <Picture
        src={Submarine}
        formats={["avif", "webp"]}
        quality={80}
        alt=""
        sizes="(min-width: 64rem) 26.9183rem, 15.8271rem"
        width={Math.round(Submarine.width)}
        class="submarine-img"
    />
</div>

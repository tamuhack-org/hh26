---
import { Picture } from "astro:assets";
import SchoolOfFish from "@assets/schedule/school-of-fish.png";
---

<style>
.schedule-school-of-fish {
    left: calc(var(--schedule-width) * 0.073012);
    top: calc(var(--schedule-width) * 1.669042);
    width: calc(var(--schedule-width) * 0.120117);
    height: calc(var(--schedule-width) * 0.070801);
}

.schedule-school-of-fish-img {
    display: block;
    width: 100%;
    height: 100%;
}

@media (width < 64rem) {
    .schedule-school-of-fish {
        display: none;
    }
}
</style>

<div
    aria-hidden="true"
    class="schedule-school-of-fish pointer-events-none absolute z-20"
>
    <Picture
        src={SchoolOfFish}
        formats={["avif", "webp"]}
        quality={80}
        alt=""
        sizes="(min-width: 96rem) 11.5312rem, 12.0117vw"
        width={Math.round(SchoolOfFish.width)}
        class="schedule-school-of-fish-img"
    />
</div>

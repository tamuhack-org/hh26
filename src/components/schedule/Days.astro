---
import SaturdayCard from "@assets/schedule/saturday-card.svg?url";
import SundayCard from "@assets/schedule/sunday-card.svg?url";
import DayCard from "./DayCard.astro";

// going to try to set up the api using the code from th26
//
export interface ScheduleEvent {
    id: string;
    date: string;
    eventName: string;
    description: string;
    location: string;
    tags: string[];
}

const SCHEDULE_ENDPOINT = "https://team.tamuhack.org/api/hh26";
const TIME_ZONE = "America/Chicago";

const weekdayFormatter = new Intl.DateTimeFormat("en-US", {
    timeZone: TIME_ZONE,
    weekday: "short",
});

async function fetchSchedule(): Promise<ScheduleEvent[]> {
    try {
        const response = await fetch(SCHEDULE_ENDPOINT);
        if (!response.ok) {
            console.warn(
                `[schedule] ${SCHEDULE_ENDPOINT} returned ${response.status}`,
            );
            return [];
        }
        const data = await response.json();
        if (!Array.isArray(data)) {
            console.warn("[schedule] expected an array of events");
            return [];
        }
        return data as ScheduleEvent[];
    } catch (error) {
        console.warn(`[schedule] could not reach ${SCHEDULE_ENDPOINT}`, error);
        return [];
    }
}

function eventsForDay(
    events: ScheduleEvent[],
    weekday: string,
): ScheduleEvent[] {
    return events
        .filter(
            (event) =>
                weekdayFormatter.format(new Date(event.date)) === weekday,
        )
        .sort(
            (a, b) => new Date(a.date).getTime() - new Date(b.date).getTime(),
        );
}

const events = await fetchSchedule();
const saturdayEvents = eventsForDay(events, "Sat");
const sundayEvents = eventsForDay(events, "Sun");
---

<div class="schedule-days absolute z-35">
    <DayCard
        title="Saturday"
        events={saturdayEvents}
        texture={SaturdayCard}
        borderFrom="#0b0a2d"
        borderTo="#2462fc"
        borderStart="22.6%"
        borderEnd="96.7%"
        locationWeight={400}
    />
    <DayCard
        title="Sunday"
        events={sundayEvents}
        texture={SundayCard}
        borderFrom="#08091d"
        borderTo="#1d4bc2"
        borderStart="24.5%"
        borderEnd="108%"
        locationWeight={300}
    />
</div>

<style>
.schedule-days {
    left: 50%;
    top: calc(var(--schedule-width) * 2.083008);
    display: flex;
    align-items: flex-start;
    gap: 1.875rem;
    width: 61rem;
    padding: 1rem;
    transform: translateX(-50%);
}

@media (width < 64rem) {
    .schedule-days {
        left: calc(var(--schedule-width) * 0.091667);
        top: calc(var(--schedule-width) * 2.786111);
        transform: none;
        flex-direction: column;
        align-items: stretch;
        gap: calc(var(--schedule-width) * 0.105556);
        width: calc(var(--schedule-width) * 0.819444);
        padding: 0;
    }
}
</style>

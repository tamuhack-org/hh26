---
import { Image } from "astro:assets";
import Hh26Logo from "@assets/hh26-logo.png";
import About from "@components/about/About.astro";
import Faq from "@components/faq/Faq.astro";
import Footer from "@components/footer/Footer.astro";
import Landing from "@components/landing/Landing.astro";
import CompassMenu from "@components/menu/CompassMenu.astro";
import Prizes from "@components/prizes/Prizes.astro";
import Schedule from "@components/schedule/Schedule.astro";
import Layout from "../layouts/Layout.astro";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
    <div class="page-shell">
        <header class="relative">
            <a
                href="https://tamuhack.org"
                aria-label="Visit the TAMUhack website"
                class="absolute top-3 left-4 z-10"
                ><Image
                    src={Hh26Logo}
                    format="avif"
                    quality={80}
                    alt=""
                    aria-hidden="true"
                    loading="eager"
                    layout="fixed"
                    width={56}
                    widths={[40, 56, 80, 112]}
                    sizes="(min-width: 64rem) 56px, 40px"
                    class="w-[40px] lg:w-[56px]"
                /></a
            >
        </header>
        <div class="compass-overlay">
            <CompassMenu variant="ring" />
        </div>
        <main>
            <h1 class="sr-only">HowdyHack 2026</h1>
            <Landing />
            <About />
            <Faq />
            <Schedule />
            <Prizes />
        </main>
    </div>
    <div class="footer-wrapper bg-[#080621]">
        <div class="mx-auto max-w-500 px-8 pt-16 lg:px-16">
            <Footer />
        </div>
    </div>
</Layout>

<style>
.page-shell {
    position: relative;
}

.compass-overlay {
    position: absolute;
    top: 0;
    right: 1.5rem;
    bottom: 0;
    z-index: 50;
    width: 12rem;
    pointer-events: none;
}

.compass-overlay :global(.compass-menu) {
    position: sticky;
    top: max(0px, calc(100dvh - 12rem));
    pointer-events: auto;
}

@media (width < 64rem) {
    .compass-overlay {
        display: none;
    }

    .compass-overlay :global(.compass-menu) {
        --compass-scale: 0.75;
    }
}
</style>
